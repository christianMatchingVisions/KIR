---
/**
 * index.astro — the REBUILT homepage (light "Arctic Day" theme).
 *
 * Composition (top → bottom):
 *   1. <HomeHero/>                — two-column hero, original CSS/SVG visual.
 *   2. TOPLIST section #parhaat   — heading row + grid of FIVE <CasinoCard>.
 *   3. <FeatureStrip/>            — 4-column "why us" band.
 *   4. INTRO long-form content    — the site's EXISTING home copy, extracted
 *                                   verbatim from src/fragments/home/body.html
 *                                   (.intro-paragraph + .wp-content-area), with
 *                                   self-origin URLs rewritten root-relative and
 *                                   broken ShortPixel placeholder <img>s removed.
 *                                   No new SEO prose is authored here.
 *
 * HEAD: <BaseLayout seoPath="/"> with NO title prop, so the Phase-1 SEO
 * registry re-emits the real, indexed home <title>/canonical/description/
 * robots/OpenGraph/Twitter/JSON-LD VERBATIM (penalty-recovery requirement).
 *
 * NOTE: the `home` fragment is excluded from the catch-all route
 * (src/pages/[...slug].astro → OWNED_ELSEWHERE) so this file owns "/".
 *
 * TOPLIST DATA: top 5 from `search-two-casino-selected`. That config returns 5
 * rows with real ratings (the rebuild's intended "selected" home list). The
 * `search-service-casino` fallback only fires if the primary yields fewer than
 * 5 rows OR every rating is null (defensive — it does not fire on real data).
 */
import BaseLayout from "../layouts/BaseLayout.astro";
import HomeHero from "../components/HomeHero.astro";
import FeatureStrip from "../components/FeatureStrip.astro";
import CasinoCard from "../components/CasinoCard.astro";
import CasinoRow from "../components/CasinoRow.astro";
import RelatedCasinos from "../components/RelatedCasinos.astro";
import Icon from "../components/Icon.astro";
import { getToplist, type ToplistCasino } from "../lib/toplist";

// Raw home body fragment (build-time only; ?raw keeps it out of the client).
import homeBody from "../fragments/home/body.html?raw";

/* -------------------------------------------------------------------------- */
/* Toplist (top 5, curated) + Top 10 (below, curated lead + backfill)         */
/* -------------------------------------------------------------------------- */

const FALLBACK_CONFIG = "search-service-casino";

// Exclude closed/expired casinos (names flagged "Suljettu") so the homepage
// never fronts a casino that no longer accepts players.
const isOpen = (c: ToplistCasino) => !/\bsuljettu\b/i.test(c.name ?? "");

// Single pool every curated list below is drawn from — the full captured
// casino roster, open only.
const pool: ToplistCasino[] = getToplist(FALLBACK_CONFIG).filter(isOpen);
const bySlug = new Map(pool.map((c) => [c.slug, c]));

// Curated top-5 (replaces the previous data-driven picks).
const TOP5_SLUGS = [
  "tikkari-casino",
  "urho-casino",
  "spinnair",
  "kumobet-ccasino",
  "jackburst-casino",
];
const topCasinos: ToplistCasino[] = TOP5_SLUGS.map((s) => bySlug.get(s)).filter(
  (c): c is ToplistCasino => c != null,
);

// Top-10 section: the curated addition (Pelipeto) + the five casinos bumped
// out of the top-5 by the swap above, backfilled from the pool to reach 10.
const TOP10_LEAD_SLUGS = [
  "pelipeto-kasino",
  "mahti-kasino",
  "lucky-spins-kasino",
  "slotsi-kasino",
  "buusti-kasino",
  "nopein-kasino",
];
const top10Lead: ToplistCasino[] = TOP10_LEAD_SLUGS.map((s) => bySlug.get(s)).filter(
  (c): c is ToplistCasino => c != null,
);
const usedSlugs = new Set([...TOP5_SLUGS, ...top10Lead.map((c) => c.slug)]);
const top10Backfill = pool
  .filter((c) => !usedSlugs.has(c.slug))
  .slice(0, Math.max(0, 10 - top10Lead.length));
const top10Casinos: ToplistCasino[] = [...top10Lead, ...top10Backfill].slice(0, 10);

// Sidebar recommendations — deliberately DIFFERENT brands than the top-5 cards
// AND the top-10 list below (the sidebar used to mirror the same brands,
// which reads as padding). Pull from the full list, drop anything already
// fronted above, take the next 5.
const frontedSlugs = new Set([...usedSlugs, ...top10Backfill.map((c) => c.slug)]);
const sideCasinos: ToplistCasino[] = pool
  .filter((c) => !frontedSlugs.has(c.slug))
  .slice(0, 5);

/* -------------------------------------------------------------------------- */
/* Extract the existing long-form home copy from the body fragment            */
/* -------------------------------------------------------------------------- */

const SITE_ORIGIN = "https://kasinotilmanrekisteroitymista.com";

/**
 * Return the inner HTML of the first `<div class="...needle...">` in `html`,
 * matching `<div>`/`</div>` nesting by depth (the WP blocks contain nested
 * divs, so a flat regex would close too early). Returns "" when not found.
 */
function extractDivByClass(html: string, needle: string): string {
  // Locate the opening tag of the wrapper div whose class contains `needle`.
  const openRe = new RegExp(
    `<div\\b[^>]*class=["'][^"']*\\b${needle.replace(/[.*+?^${}()|[\]\\]/g, "\\$&")}\\b[^"']*["'][^>]*>`,
    "i",
  );
  const openMatch = openRe.exec(html);
  if (!openMatch) return "";

  const start = openMatch.index + openMatch[0].length;
  // Walk div open/close tags from `start`, tracking depth (we begin inside 1).
  const tagRe = /<\/?div\b[^>]*>/gi;
  tagRe.lastIndex = start;
  let depth = 1;
  let m: RegExpExecArray | null;
  while ((m = tagRe.exec(html)) !== null) {
    if (m[0].startsWith("</")) {
      depth -= 1;
      if (depth === 0) return html.slice(start, m.index);
    } else {
      depth += 1;
    }
  }
  return ""; // unbalanced — bail rather than render a runaway slice
}

/**
 * Clean an extracted prose block for the light theme:
 *  - rewrite self-origin absolute URLs (href/src) to root-relative,
 *  - drop the broken ShortPixel `data:image/svg+xml;base64,...` placeholder
 *    <img>s (their real src lives base64-encoded in data-u and never loads
 *    here), which would otherwise render as empty 0-size boxes,
 *  - strip ShortPixel/translate housekeeping leftovers (data-spai, #gtx-trans).
 */
function cleanProse(html: string): string {
  if (!html) return "";
  return (
    html
      // Self-origin absolute → root-relative (normal + escaped + protocol-rel).
      .replace(new RegExp(`https?:\\\\/\\\\/${escapeHost()}`, "gi"), "\\/")
      .replace(new RegExp(`https?://${escapeHost()}`, "gi"), "")
      .replace(new RegExp(`(?<=["'(\\s])//${escapeHost()}`, "gi"), "")
      // Remove ShortPixel placeholder images (no usable src in this build).
      .replace(/<img\b[^>]*\bsrc=["']data:image\/svg\+xml[^"']*["'][^>]*>/gi, "")
      // Remove the stray Google-translate widget div left in one FAQ answer.
      // The widget block is BALANCED (<div id=gtx-trans><div class=icon>
      // </div></div>), so it must be removed cleanly: the old replacement
      // emitted an extra </div>, which made the HTML parser close the FAQ
      // <ul> early and eject the remaining 6 <li> out of the list (axe
      // "listitem", serious).
      .replace(/<div id="gtx-trans"[\s\S]*?<\/div>\s*<\/div>/gi, "")
      // Wrap ORPHANED <li> runs in a <ul>: the scraped home FAQ items lost
      // their list wrapper in extraction, shipping bare <li> children of a
      // <div> (invalid semantics; axe "listitem", serious). Runs already
      // inside an open <ul>/<ol> are left untouched.
      .replace(/(?:<li\b[\s\S]*?<\/li>\s*)+/gi, (run, offset, full) => {
        const before = full.slice(0, offset);
        const lastOpen = Math.max(before.lastIndexOf("<ul"), before.lastIndexOf("<ol"));
        const lastClose = Math.max(before.lastIndexOf("</ul>"), before.lastIndexOf("</ol>"));
        return lastOpen > lastClose ? run : `<ul>${run}</ul>`;
      })
  );
}

function escapeHost(): string {
  return SITE_ORIGIN.replace(/^https?:\/\//, "").replace(
    /[.*+?^${}()|[\]\\]/g,
    "\\$&",
  );
}

/**
 * Balance <div> tags in an extracted prose fragment so it is self-contained.
 * The legacy WP home content has a stray (unmatched) </div>; injected via
 * set:html it would underflow and prematurely close the surrounding
 * .intro__main / .intro__grid, kicking the sidebar <aside> out of the grid.
 * We drop stray closes that would underflow and append any missing closes,
 * so the fragment can never leak out of its container.
 */
function balanceDivs(html: string): string {
  if (!html) return "";
  let depth = 0;
  let out = "";
  let last = 0;
  const re = /<div\b[^>]*>|<\/div\s*>/gi;
  let m: RegExpExecArray | null;
  while ((m = re.exec(html)) !== null) {
    if (m[0][1] === "/") {
      if (depth === 0) {
        // stray close — drop it (keep the text before it, skip the tag)
        out += html.slice(last, m.index);
        last = m.index + m[0].length;
        continue;
      }
      depth -= 1;
    } else {
      depth += 1;
    }
  }
  out += html.slice(last);
  if (depth > 0) out += "</div>".repeat(depth);
  return out;
}

const introHtml = balanceDivs(cleanProse(extractDivByClass(homeBody, "intro-paragraph")));
const rawContentHtml = balanceDivs(cleanProse(extractDivByClass(homeBody, "wp-content-area")));

/* -------------------------------------------------------------------------- */
/* Build a "Sisällys" (table of contents) from the prose <h2> headings, and   */
/* inject a stable id on each h2 so the TOC can smooth-scroll to it. The TOC   */
/* fills the right sidebar; ids also give the page in-content jump anchors.    */
/* -------------------------------------------------------------------------- */

interface TocEntry {
  id: string;
  label: string;
}

/** Finnish-aware slug: ä→a, ö→o, å→a, strip tags/punctuation, kebab-case. */
function slugify(text: string): string {
  return text
    .toLowerCase()
    .replace(/<[^>]+>/g, "") // any inline tags inside the heading
    .replace(/&[a-z]+;|&#\d+;/g, " ") // entities
    .replace(/ä/g, "a")
    .replace(/ö/g, "o")
    .replace(/å/g, "a")
    .normalize("NFKD")
    .replace(/[̀-ͯ]/g, "") // strip combining diacritics
    .replace(/[^a-z0-9\s-]/g, "")
    .trim()
    .replace(/\s+/g, "-")
    .replace(/-+/g, "-")
    .slice(0, 60)
    .replace(/^-+|-+$/g, "");
}

/**
 * Walk the content HTML, give every <h2> a unique id (preserving any existing
 * id), and collect a TOC. Returns the rewritten HTML plus the TOC entries.
 */
function buildTocAndIds(html: string): { html: string; toc: TocEntry[] } {
  if (!html) return { html, toc: [] };
  const toc: TocEntry[] = [];
  const used = new Set<string>();

  const out = html.replace(
    /<h2\b([^>]*)>([\s\S]*?)<\/h2>/gi,
    (_full, attrs: string, inner: string) => {
      // Plain-text label (strip inline markup) for both TOC + slug.
      const label = inner
        .replace(/<[^>]+>/g, "")
        .replace(/\s+/g, " ")
        .trim();
      if (!label) return `<h2${attrs}>${inner}</h2>`;

      // Reuse an existing id if present; otherwise derive one from the label.
      const existing = /\bid=["']([^"']+)["']/i.exec(attrs);
      let id = existing ? existing[1] : slugify(label) || "osio";
      // De-dupe.
      let unique = id;
      let n = 2;
      while (used.has(unique)) unique = `${id}-${n++}`;
      used.add(unique);
      id = unique;

      toc.push({ id, label });

      const attrsNoId = attrs.replace(/\s*\bid=["'][^"']*["']/i, "");
      return `<h2 id="${id}"${attrsNoId}>${inner}</h2>`;
    },
  );

  return { html: out, toc };
}

const { html: contentHtml, toc } = buildTocAndIds(rawContentHtml);
const hasToc = toc.length > 1;
---

<BaseLayout seoPath="/" bodyClass="home">
  <HomeHero />

  {/* ---------------- TOPLIST ---------------- */}
  <section class="section toplist" id="parhaat" aria-labelledby="toplist-title">
    <div class="container">
      <div class="toplist__head">
        <h2 id="toplist-title" class="toplist__title">
          <span class="toplist__title-icon" aria-hidden="true">
            <Icon name="trophy" size={26} />
          </span>
          Parhaat kasinot ilman rekisteröitymistä
        </h2>
        <a class="toplist__all" href="/kaikki-kasinot/">
          Näytä kaikki kasinot
          <Icon name="arrow-right" size={18} />
        </a>
      </div>

      {topCasinos.length > 0 ? (
        <ul class="toplist__grid" role="list">
          {topCasinos.map((casino, i) => (
            <li class="toplist__item reveal" class:list={[`d${Math.min(i + 1, 5)}`]}>
              <CasinoCard casino={casino} rank={i + 1} />
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted text-center">Kasinolistaus ei ole juuri nyt saatavilla.</p>
      )}
    </div>
  </section>

  {/* ---------------- TOP 10 ---------------- */}
  {top10Casinos.length > 0 && (
    <section class="section top10" id="top10" aria-labelledby="top10-title">
      <div class="container">
        <div class="toplist__head">
          <h2 id="top10-title" class="toplist__title">
            <span class="toplist__title-icon" aria-hidden="true">
              <Icon name="trophy" size={26} />
            </span>
            Top 10 kasinot ilman rekisteröitymistä
          </h2>
        </div>
        <ul class="top10__list" role="list">
          {top10Casinos.map((casino, i) => (
            <li class="top10__item reveal">
              <CasinoRow casino={casino} rank={i + 1} />
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {/* ---------------- FEATURE STRIP ---------------- */}
  <FeatureStrip />

  {/* ---------------- INTRO / EXISTING LONG-FORM COPY ----------------
      2-column on desktop (≥980px) inside .container--wide: a readable prose
      column + a sticky sidebar (top casinos + "Sisällys" jump-links) that
      fills the previously-blank right margin. Stacks to one column below.

      The 7k-word body is wrapped in a JS-clamp: collapsed it shows the first
      portion behind a max-height + gradient fade with a "Lue lisää" button.
      CRITICAL: the clamp uses overflow/max-height clipping (NOT display:none
      or conditional rendering), so the FULL content stays in the DOM for
      crawlers, and shows in full when JS is disabled (the script adds the
      .intro-prose--clamp class; without JS the wrapper is never clamped). */}
  {(introHtml || contentHtml) && (
    <section class="section--tight intro" aria-label="Tietoa kasinoista ilman rekisteröitymistä">
      <div class="container--wide intro__grid">
        <div class="intro__main">
          {introHtml && (
            <div class="intro__lead kir-prose reveal" set:html={introHtml} />
          )}
          {contentHtml && (
            <div class="intro__prose reveal d1" data-intro-prose>
              <div class="intro-prose__inner kir-prose" set:html={contentHtml} />
              <button
                type="button"
                class="intro-prose__toggle btn-outline"
                data-intro-toggle
                aria-expanded="false"
                hidden
              >
                <span class="intro-prose__toggle-more">Lue lisää</span>
                <span class="intro-prose__toggle-less">Näytä vähemmän</span>
                <Icon name="chevron-right" size={18} class="intro-prose__toggle-ico" />
              </button>
            </div>
          )}
        </div>

        <aside class="intro__side" aria-label="Sivun sisältö ja suositukset">
          <div class="intro__side-sticky">
            <RelatedCasinos casinos={sideCasinos} limit={5} title="Suosittuja kasinoita" />
            {hasToc && (
              <nav class="intro-toc card" aria-label="Sisällys">
                <h2 class="intro-toc__title">Sisällys</h2>
                <ol class="intro-toc__list" role="list">
                  {toc.map((entry) => (
                    <li class="intro-toc__item">
                      <a class="intro-toc__link" href={`#${entry.id}`}>
                        <Icon name="chevron-right" size={14} class="intro-toc__ico" />
                        <span>{entry.label}</span>
                      </a>
                    </li>
                  ))}
                </ol>
              </nav>
            )}
          </div>
        </aside>
      </div>
    </section>
  )}

  {/* ---------------- "Lue lisää" expander + TOC active-link wiring ----------------
      Progressive enhancement only: if this script never runs (JS off, parse
      error) the full prose renders unclamped and every word is in the DOM. */}
  <script>
    (() => {
      // Scope everything to the STABLE .intro section. The preserved WordPress
      // prose (injected via set:html) can be re-parented by the browser's HTML5
      // parser, which hoists the toggle button OUT of [data-intro-prose]. So we
      // never query the toggle from the wrapper — we query from the section, and
      // we hold the clamp/open STATE on the section (see the matching CSS), so it
      // stays in sync wherever the parser ends up putting the button.
      const section = document.querySelector<HTMLElement>(".intro");
      if (!section) return;
      const inner = section.querySelector<HTMLElement>(".intro-prose__inner");
      const toggle = section.querySelector<HTMLButtonElement>("[data-intro-toggle]");
      if (!inner || !toggle) return;

      // Only clamp when the content is actually tall enough to be worth hiding.
      // (~1100px collapsed height target — see .intro--clamp in the CSS.)
      const CLAMP_PX = 1100;
      const apply = () => {
        if (inner.scrollHeight <= CLAMP_PX + 240) {
          // Short enough already — leave fully expanded, no button.
          section.classList.remove("intro--clamp");
          toggle.hidden = true;
          return;
        }
        section.classList.add("intro--clamp");
        toggle.hidden = false;
      };
      apply();

      toggle.addEventListener("click", () => {
        const expanded = section.classList.toggle("is-open");
        toggle.setAttribute("aria-expanded", String(expanded));
        // When collapsing, keep the user anchored to the top of the section.
        if (!expanded) {
          const top = section.getBoundingClientRect().top + window.scrollY - 90;
          window.scrollTo({ top, behavior: "auto" });
        }
      });

      // Re-evaluate the clamp threshold if the viewport width changes the
      // measured height materially (debounced).
      let t: number | undefined;
      window.addEventListener("resize", () => {
        window.clearTimeout(t);
        t = window.setTimeout(() => {
          if (!section.classList.contains("is-open")) apply();
        }, 200);
      });

      // Highlight the current TOC entry as its section scrolls into view.
      const toc = document.querySelector(".intro-toc");
      if (toc && "IntersectionObserver" in window) {
        const links = new Map<string, HTMLAnchorElement>();
        toc.querySelectorAll<HTMLAnchorElement>(".intro-toc__link").forEach((a) => {
          const id = a.getAttribute("href")?.slice(1);
          if (id) links.set(id, a);
        });
        const headings = inner.querySelectorAll<HTMLElement>("h2[id]");
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              const a = links.get((e.target as HTMLElement).id);
              if (a && e.isIntersecting) {
                toc
                  .querySelectorAll(".intro-toc__link.is-active")
                  .forEach((el) => el.classList.remove("is-active"));
                a.classList.add("is-active");
              }
            }
          },
          { rootMargin: "-80px 0px -70% 0px", threshold: 0 },
        );
        headings.forEach((h) => io.observe(h));
      }
    })();
  </script>
</BaseLayout>

<style>
  /* ---------------- Toplist section ---------------- */
  /* Tighter top padding than the global .section so the offer cards rise
     closer to the hero (helps the full first row sit above the fold). */
  .toplist {
    padding-top: clamp(0.85rem, 0.7rem + 0.5vw, 1.2rem);
  }
  .toplist__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    margin-bottom: clamp(0.7rem, 0.6rem + 0.5vw, 1rem);
  }
  .toplist__title {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem);
    color: var(--navy);
    margin: 0;
    line-height: 1.2;
  }
  .toplist__title-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    flex: none;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand);
  }
  .toplist__all {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    color: var(--brand);
    white-space: nowrap;
  }
  .toplist__all:hover {
    color: var(--brand-dark);
  }

  /* 5-up ≥1100px, 3-up tablet, 2-up small, 1-up phone. */
  .toplist__grid {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(0.85rem, 0.5rem + 1.2vw, 1.4rem);
  }
  .toplist__item {
    display: flex;
  }
  .toplist__item > :global(.casino-card) {
    width: 100%;
  }

  @media (max-width: 1100px) {
    .toplist__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  @media (max-width: 760px) {
    .toplist__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 480px) {
    .toplist__grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Top 10 section ---------------- */
  .top10__list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  /* ---------------- Intro long-form prose ---------------- */
  .intro {
    background: var(--bg);
  }

  /* 2-column on desktop: prose (capped reading measure) + sticky sidebar that
     fills what used to be empty margin. One column below 980px. */
  .intro__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: clamp(1.75rem, 1.2rem + 2.5vw, 3rem);
    align-items: start;
  }
  @media (min-width: 980px) {
    .intro__grid {
      grid-template-columns: minmax(0, 1fr) minmax(300px, 340px);
    }
  }
  .intro__main {
    min-width: 0;
    /* Comfortable reading measure even in the wide container. */
    max-width: 760px;
  }

  .intro__side {
    min-width: 0;
  }
  .intro__side-sticky {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }
  @media (min-width: 980px) {
    .intro__side-sticky {
      position: sticky;
      /* Clear the 72px sticky header + a little breathing room. */
      top: 88px;
      max-height: calc(100vh - 104px);
      overflow-y: auto;
      overscroll-behavior: contain;
      scrollbar-gutter: stable;
    }
  }

  .intro__lead {
    margin-bottom: 1.25rem;
  }
  .intro__lead :global(p:first-child) {
    font-size: 1.1rem;
    color: var(--ink-2);
  }

  /* ---------------- "Lue lisää" expander ----------------
     Collapsed: clip the prose to a max-height with a soft gradient fade and a
     toggle button. The full markup ALWAYS stays in the DOM (overflow clipping,
     not display:none / conditional render), so crawlers see all ~7k words and
     a no-JS visitor reads the whole thing (the clamp class is added by JS). */
  .intro__prose {
    position: relative;
  }
  /* The clamp + open state classes live on the SECTION (.intro), not on the
     prose wrapper: the preserved WordPress HTML injected via set:html can be
     re-parented by the HTML5 parser (foster-parenting), which ejects the toggle
     button out of [data-intro-prose]. Anchoring state on the always-stable
     section keeps the clamp, fade, button label and chevron in sync regardless
     of where the parser places the button. The .intro-prose__inner is the clip
     target wherever it ends up inside the section. */
  .intro.intro--clamp .intro-prose__inner {
    max-height: 1100px;
    overflow: hidden;
    /* anchor the ::after fade to the clip edge (without this the gradient
       attaches to a higher ancestor and the cut looks hard / mid-word). */
    position: relative;
  }
  .intro.is-open .intro-prose__inner {
    max-height: none;
    overflow: visible;
  }
  /* Gradient fade over the clipped bottom edge (collapsed state only). */
  .intro.intro--clamp .intro-prose__inner::after {
    content: "";
    position: absolute;
