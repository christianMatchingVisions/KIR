---
/**
 * Catch-all route (Phase 5 — light-theme rewire).
 *
 * Renders every remaining scraped page fragment in src/fragments/ through the
 * NEW light templates (ArticlePage / MoneyPage) instead of the legacy dark
 * Shell.astro. Routes are still derived from each fragment's meta.json `path`,
 * so URLs match the original WordPress site exactly.
 *
 * OWNED ELSEWHERE (never rendered here):
 *   - "home"        → src/pages/index.astro            (light homepage owns "/")
 *   - "uutiset"     → src/pages/uutiset/*              (news section)
 *   - World-Cup special page                          (its own route)
 *   - "casino__*"   → src/pages/casino/[slug].astro    (305 light reviews)
 *   - "casino"      → src/pages/casino/index.astro     (the /casino/ hub)
 * What remains: ~218 blog posts (/<slug>/), 14 money/category pages, 23 ht-faq
 * pages (/ht-faq/<slug>/ incl. the index), 8 provider pages
 * (/pragmatic-play/<slug>/) and the WP text/utility pages.
 *
 * CLASSIFICATION (per page, by slug/path):
 *   MONEY PAGE  if the slug is a known money/category slug OR
 *               getToplistConfigForSlug(slug) maps to a NON-default config.
 *               → <MoneyPage> (intro prose + ranked toplist).
 *   ARTICLE     otherwise (posts, provider, ht-faq, text/utility).
 *               → <ArticlePage> (hero + 2-col body).
 *
 * BODY SOURCE PRIORITY (articles):
 *   getPost(slug).contentHtml
 *     → getPage(slug).contentHtml
 *       → getFaq(slug) (question + answerHtml)
 *         → the /ht-faq/ index → a generated list of all FAQs
 *           → the scraped fragment's main prose (.wp-content-area / .intro-paragraph)
 * Self-origin URLs are already root-relative in REST HTML; we additionally
 * relativize them in any fragment-extracted prose.
 *
 * COMPLIANCE: every /go/<slug>/ link in rendered prose is forced to carry
 * rel="sponsored nofollow" via ensureSponsored() (same approach the casino route
 * uses on in-prose affiliate/banner links). The dark Shell.astro / redesign.css /
 * arctic.js are NO LONGER imported or used by this catch-all.
 */
import ArticlePage from "../layouts/ArticlePage.astro";
import MoneyPage from "../layouts/MoneyPage.astro";
import {
  getPost,
  getPage,
  getFaq,
  getFaqs,
  getPosts,
  getToplistConfigForSlug,
  optimizeProseImages,
  demoteBodyH1,
  DEFAULT_TOPLIST_CONFIG,
} from "../lib/content";
import { getAllCasinos } from "../lib/casino-data";
import {
  relatedGuides as buildRelatedGuides,
  topicLinksFor,
  articleAuthorJsonLd,
  type RelatedLink,
} from "../lib/related";
import { getSeoHead } from "../lib/seo-head";

interface FragmentMeta {
  htmlAttrs?: string;
  bodyAttrs?: string;
  path: string;
}

export function getStaticPaths() {
  const bodies = import.meta.glob<string>("../fragments/*/body.html", {
    query: "?raw",
    import: "default",
    eager: true,
  });
  const metas = import.meta.glob<{ default: FragmentMeta }>("../fragments/*/meta.json", {
    eager: true,
  });

  // Fragments owned by dedicated light-theme routes (rendered there, not here).
  const OWNED_ELSEWHERE = new Set([
    "home", // src/pages/index.astro (light homepage owns "/")
    "uutiset", // src/pages/uutiset/index.astro
    "huuhkajien-jatko-em-jalkapalloturnauksessa-riippuu-tuurista", // World-Cup special page
    "casino", // src/pages/casino/index.astro (the /casino/ hub)
  ]);

  // The 305 casino__<slug> fragments are owned by src/pages/casino/[slug].astro.
  const isCasinoFragment = (dirName: string) => dirName.startsWith("casino__");

  return Object.entries(metas)
    .filter(([metaPath]) => {
      const dirName = metaPath.split("/").at(-2) ?? "";
      return !OWNED_ELSEWHERE.has(dirName) && !isCasinoFragment(dirName);
    })
    .map(([metaPath, metaModule]) => {
      const dir = metaPath.replace(/\/meta\.json$/, "");
      const meta = metaModule.default;
      const bodyHtml = bodies[`${dir}/body.html`];
      if (bodyHtml === undefined) {
        throw new Error(`Fragment ${dir} is missing body.html`);
      }
      const path = String(meta.path ?? "/");
      const slug = path.replace(/^\/+|\/+$/g, "");
      return {
        params: { slug: slug === "" ? undefined : slug },
        props: {
          path,
          fragmentBodyHtml: bodyHtml,
        },
      };
    });
}

interface Props {
  /** The page's real indexed URL (with leading + trailing slash). */
  path: string;
  /** Raw scraped <body> HTML — used only as the last-resort prose source. */
  fragmentBodyHtml: string;
}

const { path, fragmentBodyHtml } = Astro.props as Props;

/** Live site origin — relativized in any fragment-extracted prose. */
const SITE_ORIGIN = "https://kasinotilmanrekisteroitymista.com";

/* -------------------------------------------------------------------------- *
 * Slug + classification                                                      *
 * -------------------------------------------------------------------------- */

// The leaf slug of the path (e.g. "/pragmatic-play/wolf-gold-arvostelu/" → "wolf-gold-arvostelu").
const slug = path.replace(/^\/+|\/+$/g, "").split("/").pop() ?? "";

// The full path is a /ht-faq/<x>/ page (item or index).
const isHtFaqPath = /^\/ht-faq(\/|$)/.test(path);
const isHtFaqIndex = path === "/ht-faq/";
// A provider sub-page like /pragmatic-play/<game>/ (NOT the /pragmatic-play/ hub).
const isProviderSubPage = /^\/pragmatic-play\/.+/.test(path);

// Explicit money/category slugs (mirrors the project's MONEY-PAGE SLUGS set).
const MONEY_SLUGS = new Set([
  "suomen-parhaat-nettikasinot",
  "kaikki-kasinot",
  "kasinobonukset",
  "cashback-kasinot",
  "uudet-kasinot",
  "trustly-kasinot",
  "pikakasinot",
  "zimpler-pikakasinot",
  "apple-pay-casinot",
  "brite-kasinot",
  "euteller-kasinot",
  "kryptokasinot",
  "mga-kasinot",
  "curacao-kasinot",
  "nettikasinot-luotettavat-kasinot",
  "nettikasino-ilman-rekisteroitymista",
]);

const toplistConfig = getToplistConfigForSlug(slug);
// MONEY when it's an explicit money slug OR has a real (non-default) toplist map.
// ht-faq + provider sub-pages are never money pages.
const isMoneyPage =
  !isHtFaqPath &&
  !isProviderSubPage &&
  (MONEY_SLUGS.has(slug) || toplistConfig !== DEFAULT_TOPLIST_CONFIG);

/* -------------------------------------------------------------------------- *
 * Preserved SEO head → registry title (matches the indexed <title>).          *
 * -------------------------------------------------------------------------- */

const seo = getSeoHead(path);

/**
 * The visible H1 / hero heading. Prefer the registry title (so it matches the
 * preserved <title>), but strip the trailing " - <site>" / " | <site>" suffix
 * Rank Math appends — that belongs in <title>, not in an H1. Fall back to REST
 * titles, then a humanized slug.
 */
function cleanTitle(t: string | null | undefined): string | null {
  if (!t) return null;
  const trimmed = t.replace(/\s*[|\-–—]\s*kasinotilmanrekisteroitymista\.com\s*$/i, "").trim();
  return trimmed || null;
}

/* -------------------------------------------------------------------------- *
 * COMPLIANCE: force rel="sponsored nofollow" on every /go/ link in prose.     *
 * Mirrors the casino route's ensureSponsored(): adds the rel when missing and  *
 * merges sponsored+nofollow into an existing rel (dedup, order-stable).        *
 * Idempotent, attribute-level, non-/go/ links untouched.                       *
 * -------------------------------------------------------------------------- */

function ensureSponsored(html: string | null | undefined): string {
  if (!html) return "";
  return html.replace(
    /<a\b([^>]*\bhref="\/go\/[^"]*"[^>]*)>/gi,
    (_whole, attrs: string) => {
      const relMatch = attrs.match(/\brel="([^"]*)"/i);
      if (!relMatch) {
        return `<a${attrs} rel="sponsored nofollow">`;
      }
      const tokens = new Set(
        relMatch[1].split(/\s+/).filter(Boolean).map((t) => t.toLowerCase()),
      );
      tokens.add("sponsored");
      tokens.add("nofollow");
      const merged = [...tokens].join(" ");
      const newAttrs = attrs.replace(/\brel="[^"]*"/i, `rel="${merged}"`);
      return `<a${newAttrs}>`;
    },
  );
}

/* -------------------------------------------------------------------------- *
 * B2 — RESTORE BODY JSON-LD (ht-faq Organization schema).                      *
 *                                                                              *
 * Rank Math placed each page's primary schema graph in the <head> (preserved   *
 * verbatim by the SEO registry → BaseLayout). A SECOND, standalone             *
 * <script type="application/ld+json"> Organization block lived in the page     *
 * <body> on the live site. For the 22 /ht-faq/<q>/ question pages that body    *
 * block is NOT mirrored in head.html, so re-emitting the preserved head alone  *
 * DROPS it — a structured-data regression on a recovering domain.              *
 *                                                                              *
 * extractBodyJsonLd() pulls those <script type="application/ld+json"> blocks    *
 * VERBATIM out of the scraped fragment body.html. We then drop any block that  *
 * is byte-identical to a block already emitted from the preserved head         *
 * (seo.jsonLd) so nothing is double-emitted. JSON-LD is valid anywhere in the  *
 * document, so these are rendered in the page body — restoring the live        *
 * Organization schema without touching BaseLayout or the byte-faithful head.   *
 *                                                                              *
 * (Mirrors the verbatim-extract approach the casino route uses for its in-body *
 * Review/Rating schema; replicated inline here to avoid a cross-team import    *
 * dependency on src/lib/casino-schema.ts that may not exist at build time.)    *
 * -------------------------------------------------------------------------- */

/** Every <script type="application/ld+json">…</script> block in `html`, VERBATIM. */
function extractBodyJsonLd(html: string): string[] {
  if (!html) return [];
  const re =
    /<script\b[^>]*\btype=["']application\/ld\+json["'][^>]*>[\s\S]*?<\/script>/gi;
  return html.match(re) ?? [];
}

/** Collapse insignificant whitespace for an order-stable, byte-faithful dedupe key. */
function jsonLdKey(block: string): string {
  return block.replace(/\s+/g, " ").trim();
}

/** Relativize self-origin absolute URLs in fragment-extracted prose. */
function relativizeSelfOrigin(html: string): string {
  return html
    .replace(new RegExp(`https?://${escapeRe(SITE_ORIGIN.replace(/^https?:\/\//, ""))}`, "gi"), "")
    .replace(/(?<=["'(\s])\/\/kasinotilmanrekisteroitymista\.com/gi, "");
}

function escapeRe(s: string): string {
  return s.replace(/[.*+?^${}()|[\]\\]/g, "\\$&");
}

/* -------------------------------------------------------------------------- *
 * Last-resort prose extraction from the scraped fragment <body>.              *
 * Used only when no REST source exists. Pulls the main editorial container    *
 * (.wp-content-area, then .intro-paragraph) out of the legacy chrome so we     *
 * render content, not the old dark header/footer/nav.                          *
 * -------------------------------------------------------------------------- */

/** Extract the inner HTML of the first element carrying `className`, or null. */
function extractByClass(html: string, className: string): string | null {
  // Find the opening tag with the class, then walk to its matching close tag.
  const openRe = new RegExp(`<([a-z]+)\\b[^>]*class="[^"]*\\b${escapeRe(className)}\\b[^"]*"[^>]*>`, "i");
  const m = openRe.exec(html);
  if (!m) return null;
  const tag = m[1];
  const start = m.index;
  const afterOpen = openRe.lastIndex || start + m[0].length;
  // Balance nested same-tag pairs from afterOpen to find the matching close.
  const tagRe = new RegExp(`<(/?)${tag}\\b[^>]*>`, "gi");
  tagRe.lastIndex = afterOpen;
  let depth = 1;
  let tm: RegExpExecArray | null;
  while ((tm = tagRe.exec(html)) !== null) {
    if (tm[1] === "/") {
      depth--;
      if (depth === 0) {
        return html.slice(afterOpen, tm.index).trim() || null;
      }
    } else {
      depth++;
    }
  }
  // Unbalanced — return everything after the open tag as a best effort.
  return html.slice(afterOpen).trim() || null;
}

function fragmentProse(): string | null {
  const main =
    extractByClass(fragmentBodyHtml, "wp-content-area") ??
    extractByClass(fragmentBodyHtml, "intro-paragraph");
  return main ? relativizeSelfOrigin(main) : null;
}

/* -------------------------------------------------------------------------- *
 * Resolve the page content + meta, honouring the body-source priority.        *
 * -------------------------------------------------------------------------- */

const post = !isMoneyPage ? getPost(slug) : null;
const page = getPage(slug); // also the source of money-page intro copy
const faq = !isMoneyPage && isHtFaqPath && !isHtFaqIndex ? getFaq(slug) : null;

/** Humanize a slug for the rare no-title fallback ("foo-bar" → "Foo bar"). */
function humanize(s: string): string {
  if (!s) return "Sivu";
  const t = s.replace(/-/g, " ").trim();
  return t.charAt(0).toUpperCase() + t.slice(1);
}

/* ----- ARTICLE body assembly (only for the article branch) ----- */

let articleTitle = "";
let articleBody = "";
let articleDate: string | null = null;
let articleModified: string | null = null;
let breadcrumb: { label: string; href?: string }[] = [];
let eyebrow = "Artikkeli";

if (!isMoneyPage) {
  // Title: prefer registry (matches preserved <title>), then REST, then slug.
  const registryTitle = cleanTitle(seo?.title);

  if (post) {
    articleTitle = registryTitle ?? post.title ?? humanize(slug);
    articleBody = ensureSponsored(post.contentHtml);
    articleDate = post.date || null;
    articleModified = post.modified || null;
    eyebrow = "Opas";
    breadcrumb = [
      { label: "Etusivu", href: "/" },
      { label: "Oppaat", href: "/oppaat/" },
      { label: articleTitle },
    ];
  } else if (faq) {
    articleTitle = registryTitle ?? faq.question ?? humanize(slug);
    articleBody = ensureSponsored(faq.answerHtml);
    eyebrow = "UKK";
    breadcrumb = [
      { label: "Etusivu", href: "/" },
      { label: "Usein kysytyt kysymykset", href: "/ht-faq/" },
      { label: articleTitle },
    ];
  } else if (isHtFaqIndex) {
    // The /ht-faq/ archive index has no single REST body — generate a clean
    // Q&A list from getFaqs() so the page is content-rich (not the legacy chrome).
    articleTitle = registryTitle ?? cleanTitle(page?.title) ?? "Usein kysytyt kysymykset";
    const faqs = getFaqs();
    articleBody = ensureSponsored(
      faqs
        .map(
          (f) =>
            `<h2>${f.question}</h2>${f.answerHtml}`,
        )
        .join("\n"),
    );
    eyebrow = "UKK";
    breadcrumb = [
      { label: "Etusivu", href: "/" },
      { label: articleTitle },
    ];
  } else if (page) {
    // WP text/utility pages AND provider sub-pages (/pragmatic-play/<game>/).
    articleTitle = registryTitle ?? page.title ?? humanize(slug);
    articleBody = ensureSponsored(page.contentHtml);
    articleDate = page.date || null;
    articleModified = page.modified || null;
    if (isProviderSubPage) {
      eyebrow = "Peliarvostelu";
      breadcrumb = [
        { label: "Etusivu", href: "/" },
        { label: "Pragmatic Play", href: "/pragmatic-play/" },
        { label: articleTitle },
      ];
    } else {
      eyebrow = "Sivu";
      breadcrumb = [
        { label: "Etusivu", href: "/" },
        { label: articleTitle },
      ];
    }
  } else {
    // Last resort: lift the main prose out of the scraped fragment chrome.
    articleTitle = registryTitle ?? humanize(slug);
    articleBody = ensureSponsored(fragmentProse() ?? "");
    eyebrow = "Artikkeli";
    breadcrumb = [
      { label: "Etusivu", href: "/" },
      { label: articleTitle },
    ];
  }
}

/* ----- MONEY page meta ----- */
// Money intro copy comes from the REST page (all 14 money slugs have one);
// fall back to fragment prose if a future money slug lacks REST data.
const moneyTitle =
  cleanTitle(seo?.title) ?? cleanTitle(page?.title) ?? humanize(slug);
const moneyIntro = isMoneyPage
  ? ensureSponsored(page?.contentHtml || fragmentProse() || "")
  : "";

/* -------------------------------------------------------------------------- *
 * B2 — body JSON-LD to restore (ht-faq Organization schema), deduped vs head.  *
 * Scoped to /ht-faq/ pages, the documented data-loss case: their question      *
 * heads carry NO Organization block, so the live body block must be re-emitted *
 * here. We drop any block byte-identical to one already in the preserved head  *
 * (seo.jsonLd) to guard against double-emit (e.g. the /ht-faq/ index, whose    *
 * head already includes the schema). On non-ht-faq pages this stays empty —    *
 * their head schema is untouched and additive risk is kept minimal.            *
 * -------------------------------------------------------------------------- */
const headJsonLdKeys = new Set((seo?.jsonLd ?? []).map(jsonLdKey));
const restoredBodyJsonLd: string[] = isHtFaqPath
  ? extractBodyJsonLd(fragmentBodyHtml).filter(
      (block) => !headJsonLdKeys.has(jsonLdKey(block)),
    )
  : [];

/* PERFORMANCE: lazy-load + de-prioritise the large below-the-fold prose images
 * (strips legacy fetchpriority="high", adds loading="lazy"/decoding="async").
 * Applied once here so every article/money body benefits regardless of source.
 * Does not touch any above-the-fold/template hero image. */
articleBody = optimizeProseImages(articleBody);
const moneyIntroOptimized = optimizeProseImages(moneyIntro);

/* SEO: demote any stray body <h1> to <h2> so the page keeps exactly ONE H1
 * (the page template's canonical heading). Clears the Multiple-H1 error on
 * pages whose body prose opens with its own H1 (e.g. /endorphina/,
 * /pelivalmistajat/). Attribute-preserving + idempotent. */
articleBody = demoteBodyH1(articleBody);
const moneyIntroFinal = demoteBodyH1(moneyIntroOptimized);

/* -------------------------------------------------------------------------- *
 * E-E-A-T BYLINE + INTERNAL-LINK ARCHITECTURE (additive, finding H7 + links). *
 * -------------------------------------------------------------------------- *
 * For real editorial articles (a post or a guide-style page — NOT the ht-faq
 * index/items, provider stubs or money pages) we:
 *   1. show the "KIR-toimitus" byline → /toimitus/ (links the page to the
 *      existing editorial entity, a reviewer/E-E-A-T trust signal), and
 *   2. emit ONE additive Article JSON-LD block whose author/reviewedBy point at
 *      the same #editorial-team Organization (deduped vs the preserved head), and
 *   3. compute contextual "Aiheeseen liittyvät" links — related guides + topic
 *      money pages + related casino reviews — to raise incoming links to the
 *      thin money/review pages and connect orphan/single-link articles.
 * Everything below is pure build-time data → no effect on the byte-faithful head.
 */
const isArticleEditorial = !isMoneyPage && Boolean(post || (page && !isHtFaqPath && !isProviderSubPage));
const isGuideArticle = Boolean(post);

let bylineVariant: "review" | "guide" | "article" = "article";
if (isGuideArticle) bylineVariant = "guide";

let relatedReviews: RelatedLink[] = [];
let relatedGuides: RelatedLink[] = [];
let sidebarLinks: RelatedLink[] = [];
let articleAuthorBlock = "";

if (isArticleEditorial) {
  const allPosts = getPosts();
  // Related GUIDES by shared title tokens + curated topic/money-page links.
  const guideMatches = buildRelatedGuides({ slug, title: articleTitle }, allPosts, 4);
  const topicMatches = topicLinksFor(articleTitle, articleBody, 3);
  // Merge guides + topics into one column, de-duped by href, capped at 6.
  const seenHref = new Set<string>();
  relatedGuides = [...guideMatches, ...topicMatches]
    .filter((l) => l.href !== path && (seenHref.has(l.href) ? false : (seenHref.add(l.href), true)))
    .slice(0, 6);

  // Related REVIEWS, ranked by how well each open casino's facts (name + licence
  // + payment methods) overlap the article's title topic — so a Trustly guide
  // surfaces Trustly casinos, an MGA guide surfaces MGA casinos, etc. Falls back
  // to the first open casinos when nothing overlaps (module is never empty).
  const casinos = getAllCasinos();
  if (casinos.length > 0) {
    const STOP = new Set(["ja", "kasino", "kasinot", "casino", "ilman", "opas", "2026", "2025"]);
    const tok = (s: string) =>
      new Set(
        (s || "")
          .toLowerCase()
          .replace(/[^a-zåäö0-9\s]/gi, " ")
          .split(/\s+/)
          .filter((t) => t.length >= 3 && !STOP.has(t)),
      );
    // Topic tokens come from the title PLUS a capped slice of the body text, so
    // a "Trustly casinos" guide whose facts live in its prose still surfaces
    // Trustly/MGA/Curaçao casinos (the title alone is often too sparse to match).
    const topicTokens = tok(`${articleTitle} ${articleBody.slice(0, 4000)}`);
    const open = casinos.filter((c) => !c.showNoReview && c.name.trim().length > 0);
    const scored = open
      .map((c) => {
        const facts = tok([c.name, c.license ?? "", ...c.paymentMethods].join(" "));
        let score = 0;
        for (const t of topicTokens) if (facts.has(t)) score++;
        return { c, score };
      })
      .sort((a, b) => b.score - a.score || a.c.name.localeCompare(b.c.name, "fi"));
    relatedReviews = scored.slice(0, 4).map(({ c }) => ({ label: c.name, href: c.url }));
  }

  // Sidebar "Lue myös": the curated topic/money links (most useful in a rail).
  sidebarLinks = (topicMatches.length > 0 ? topicMatches : relatedGuides).slice(0, 4);

  // Additive Article author JSON-LD (author/reviewedBy → #editorial-team),
  // deduped against the preserved head so we never double-declare.
  const candidate = articleAuthorJsonLd({
    title: articleTitle,
    url: path,
    datePublished: articleDate,
    dateModified: articleModified,
  });
  if (candidate && !headJsonLdKeys.has(jsonLdKey(candidate))) {
    articleAuthorBlock = candidate;
  }
}
---

{isMoneyPage ? (
  <MoneyPage
    seoPath={path}
    title={moneyTitle}
    introHtml={moneyIntroFinal || undefined}
    toplistConfig={toplistConfig}
  />
) : (
  <ArticlePage
    seoPath={path}
    title={articleTitle}
    bodyHtml={articleBody}
    date={articleDate}
    modified={articleModified}
    breadcrumb={breadcrumb}
    eyebrow={eyebrow}
    showByline={isArticleEditorial}
    bylineVariant={bylineVariant}
    relatedReviews={relatedReviews}
    relatedGuides={relatedGuides}
    relatedLinks={sidebarLinks}
  />
)}
{/* B2: restore the live in-body Organization JSON-LD that the preserved <head>
    does not carry (ht-faq question pages). Verbatim, deduped vs head, body-
    placed (valid anywhere in the document). Empty → renders nothing. */}
{restoredBodyJsonLd.map((block) => (
  <Fragment set:html={block} />
))}
{/* E-E-A-T: additive Article author JSON-LD (author/reviewedBy → KIR-toimitus
    #editorial-team), deduped vs the preserved head. Empty → renders nothing. */}
{articleAuthorBlock && <Fragment set:html={articleAuthorBlock} />}
