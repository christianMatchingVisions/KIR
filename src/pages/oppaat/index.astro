---
/**
 * oppaat/index.astro — the "Oppaat" guides hub at /oppaat/.
 *
 * A BRAND-NEW page (there is NO scraped fragment / SEO-registry entry for
 * /oppaat/), so it renders through a CLEAN <BaseLayout> with an explicit title,
 * canonical and a freshly-built BreadcrumbList JSON-LD. It gives the site's 218
 * blog guides an internal-link home and a clear nav destination ("Oppaat").
 *
 * Content (TWO sources, merged newest-first + deduped):
 *   (a) Content-Engine 'guide' articles  → getCollection("articles") filtered to
 *       articleType === "guide" (link → /oppaat/<slug>/, rendered by
 *       /oppaat/[slug].astro). These are the engine's general-content stream.
 *   (b) the existing scraped blog guides → getPosts() (link → /<slug>/).
 * Each renders as a card — title, formatted date, short plain-text excerpt.
 * These are internal links to the guides' own canonical URLs; no affiliate /go/
 * links live on this page. Deduped by slug so an engine guide that shares a slug
 * with a scraped post is shown once (engine wins).
 *
 * GRACEFUL: when the engine delivers no guides, the list is exactly the scraped
 * posts — the hub renders identically to today.
 *
 * NOTE: this page intentionally does NOT pass a seoPath (it has no preserved
 * head). It supplies its own canonical + description + BreadcrumbList instead.
 */
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import { getPosts } from "../../lib/content";
import { isGuideArticleType } from "../../lib/content-engine-loader";

const SITE_URL = "https://kasinotilmanrekisteroitymista.com";

/* -------------------------------------------------------------------------- *
 * DEMO / PLACEHOLDER GUARD (finding H3) — mirrors /oppaat/[slug].astro.        *
 * The engine is NOT live; when wired to a demo endpoint it ships fixture       *
 * entries (slug `engine-guide-talletukset`, description "Guide desc", title    *
 * prefix ENGINEGUIDE) that never existed on the live site. We exclude them     *
 * here too so the hub never links to a stub the [slug] route no longer emits.  *
 * With no real engine guides, the engine card list is empty and the hub falls  *
 * back to exactly the scraped blog guides (graceful — see empty-state below).  *
 * -------------------------------------------------------------------------- */
const DEMO_ENGINE_SLUGS = new Set([
  "engine-guide-talletukset",
  "engine-news-uutinen",
]);
function isPlaceholderText(s: string | null | undefined): boolean {
  const t = (s ?? "").trim().toLowerCase();
  return t === "" || t === "guide desc" || t === "news desc";
}
function isRealEngineEntry(
  data: { title?: string | null; description?: string | null },
  id: string,
): boolean {
  if (DEMO_ENGINE_SLUGS.has(id)) return false;
  if (/^engine(guide|news)\b/i.test((data.title ?? "").trim())) return false;
  if (isPlaceholderText(data.description)) return false;
  return true;
}
const CANONICAL = `${SITE_URL}/oppaat/`;
const PAGE_TITLE = "Oppaat ja vinkit — Kasinot ilman rekisteröitymistä";
const PAGE_DESC =
  "Kaikki kasino-oppaat ja vinkit yhdessä paikassa: pelaaminen ilman rekisteröitymistä, maksutavat, bonukset ja vastuullinen pelaaminen.";

/* -------------------------------------------------------------------------- *
 * Helpers                                                                    *
 * -------------------------------------------------------------------------- */

/** Plain-text excerpt from excerptHtml (tags stripped, entities decoded, capped). */
function excerptText(html: string | undefined, max = 160): string {
  if (!html) return "";
  const text = html
    .replace(/<[^>]*>/g, " ")
    .replace(/&hellip;|\[&hellip;\]|\[…\]/gi, "…")
    .replace(/&nbsp;/g, " ")
    .replace(/&amp;/g, "&")
    .replace(/&#8217;/g, "’")
    .replace(/&#8211;/g, "–")
    .replace(/\s+/g, " ")
    .trim();
  if (text.length <= max) return text;
  const cut = text.slice(0, max);
  return cut.slice(0, cut.lastIndexOf(" ")).trimEnd() + "…";
}

/** Format an ISO date as Finnish "15.6.2026"; returns "" on bad input. */
function fiDate(iso: string | null | undefined): string {
  if (!iso) return "";
  const d = new Date(iso);
  if (Number.isNaN(d.getTime())) return "";
  return `${d.getDate()}.${d.getMonth() + 1}.${d.getFullYear()}`;
}

/* -------------------------------------------------------------------------- *
 * Build the unified, newest-first guide-card list (engine + scraped, deduped).
 * -------------------------------------------------------------------------- */

interface GuideCard {
  slug: string;
  href: string;
  /** May contain entity-encoded markup from the scraped title (set:html). */
  title: string;
  /** ISO date for sorting + <time>. */
  date: string;
  dateLabel: string;
  excerpt: string;
  /** "Opas" (engine guide) | "" (scraped blog guide). */
  kicker: string;
}

// (a) Engine 'guide' articles → /oppaat/<slug>/ (real entries only — the demo
// fixtures are excluded so the hub never links to a stub that no longer builds).
const engineGuides = (await getCollection("articles"))
  .filter((e) => isGuideArticleType(e.data.articleType))
  .filter((e) => isRealEngineEntry(e.data, e.id));
const engineCards: GuideCard[] = engineGuides.map((e) => {
  const date = e.data.publishedAt ?? e.data.updatedAt ?? "";
  return {
    slug: e.id,
    href: `/oppaat/${e.id}/`,
    title: e.data.title,
    date,
    dateLabel: fiDate(date),
    excerpt: excerptText(e.data.description),
    kicker: "Opas",
  };
});

// (b) Scraped blog guides → /<slug>/.
const postCards: GuideCard[] = getPosts().map((p) => ({
  slug: p.slug,
  href: `/${p.slug}/`,
  title: p.title,
  date: p.date,
  dateLabel: fiDate(p.date),
  excerpt: excerptText(p.excerptHtml),
  kicker: "",
}));

// Merge + dedupe by slug (engine wins), then newest-first (no-date sinks last).
const bySlug = new Map<string, GuideCard>();
for (const c of postCards) bySlug.set(c.slug, c);
for (const c of engineCards) bySlug.set(c.slug, c);
const posts: GuideCard[] = [...bySlug.values()].sort((a, b) =>
  (b.date || "").localeCompare(a.date || ""),
);
const postCount = posts.length;

/* -------------------------------------------------------------------------- *
 * BreadcrumbList JSON-LD (Etusivu › Oppaat).                                 *
 * -------------------------------------------------------------------------- */

const breadcrumbJsonLd = `<script type="application/ld+json">${JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Etusivu",
      item: `${SITE_URL}/`,
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Oppaat",
      item: CANONICAL,
    },
  ],
})}</script>`;
---

<BaseLayout
  title={PAGE_TITLE}
  description={PAGE_DESC}
  canonical={CANONICAL}
  jsonLd={[breadcrumbJsonLd]}
  bodyClass="guides-hub"
>
  {/* ---------------- BREADCRUMB ---------------- */}
  <nav class="section--tight crumbs-wrap" aria-label="Murupolku">
    <div class="container">
      <ol class="crumbs">
        <li class="crumbs__item"><a href="/">Etusivu</a></li>
        <li class="crumbs__sep" aria-hidden="true"><Icon name="chevron-right" size={14} /></li>
        <li class="crumbs__item" aria-current="page">Oppaat</li>
      </ol>
    </div>
  </nav>

  {/* ---------------- HERO ---------------- */}
  <section class="section--tight guides-hero" aria-labelledby="guides-title">
    <div class="container--narrow guides-hero__inner">
      <span class="eyebrow">Oppaat ja vinkit</span>
      <h1 id="guides-title" class="guides-hero__title">Oppaat ja vinkit</h1>
      <p class="lead guides-hero__lead">
        Käytännön oppaat rekisteröitymisvapaaseen pelaamiseen: maksutavat,
        bonukset, turvallisuus ja vastuullinen pelaaminen. Valitse aihe ja lue
        lisää.
      </p>
      {postCount > 0 && (
        <p class="guides-hero__count">
          <Icon name="info" size={16} class="guides-hero__count-ico" />
          {postCount} opasta ja artikkelia
        </p>
      )}
    </div>
  </section>

  {/* ---------------- GUIDE GRID ---------------- */}
  <section class="section--tight guides-grid-wrap" aria-label="Kaikki oppaat">
    <div class="container">
      {postCount > 0 ? (
        <ul class="guides-grid" role="list">
          {posts.map((p, i) => (
            <li class="guides-grid__item reveal" class:list={[`d${Math.min((i % 5) + 1, 5)}`]}>
              <a class="guide-card card card--lift" href={p.href}>
                <span class="guide-card__meta">
                  {p.kicker && <span class="guide-card__kicker">{p.kicker}</span>}
                  {p.dateLabel && (
                    <time class="guide-card__date" datetime={p.date}>
                      <Icon name="info" size={13} class="guide-card__date-ico" />
                      {p.dateLabel}
                    </time>
                  )}
                </span>
                <h2 class="guide-card__title" set:html={p.title} />
                {p.excerpt && <p class="guide-card__excerpt">{p.excerpt}</p>}
                <span class="guide-card__cta">
                  Lue opas
                  <Icon name="arrow-right" size={16} />
                </span>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <p class="muted">Oppaat eivät ole juuri nyt saatavilla.</p>
      )}
    </div>
  </section>
</BaseLayout>

<style>
  /* ---------------- Breadcrumb ---------------- */
  .crumbs-wrap {
    padding-bottom: 0;
  }
  .crumbs {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.85rem;
    color: var(--ink-3);
  }
  .crumbs__item a {
    color: var(--ink-3);
    text-decoration: none;
    font-weight: 600;
  }
  .crumbs__item a:hover {
    color: var(--brand);
  }
  .crumbs__item[aria-current="page"] {
    color: var(--ink);
    font-weight: 700;
  }
  .crumbs__sep {
    display: inline-flex;
    align-items: center;
    color: var(--ink-3);
    opacity: 0.7;
  }

  /* ---------------- Hero ---------------- */
  .guides-hero__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
  }
  .guides-hero__title {
    margin: 0;
    color: var(--navy);
    font-size: clamp(1.8rem, 1.3rem + 2.4vw, 2.7rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .guides-hero__lead {
    margin: 0;
    max-width: 64ch;
  }
  .guides-hero__count {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.35rem 0 0;
    padding: 0.3rem 0.8rem;
    border-radius: 999px;
    background: var(--bg-band);
    border: 1px solid var(--line);
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--ink-2);
  }
  .guides-hero__count-ico {
    color: var(--brand);
  }

  /* ---------------- Guide grid ---------------- */
  .guides-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 0.5rem + 1.2vw, 1.4rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .guides-grid__item {
    display: flex;
  }
  @media (max-width: 940px) {
    .guides-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .guides-grid {
      grid-template-columns: 1fr;
    }
  }

  /* ---------------- Guide card ---------------- */
  .guide-card {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.55rem;
    width: 100%;
    padding: 1.2rem 1.15rem 1.1rem;
    text-decoration: none;
    color: inherit;
  }
  .guide-card:hover {
    text-decoration: none;
  }
  .guide-card__meta {
    display: inline-flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .guide-card__kicker {
    display: inline-flex;
    align-items: center;
    padding: 0.15rem 0.55rem;
    border-radius: 999px;
    background: var(--brand-soft);
    color: var(--brand-dark);
    font-size: 0.7rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .guide-card__date {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--ink-3);
  }
  .guide-card__date-ico {
    color: var(--brand);
  }
  .guide-card__title {
    margin: 0;
    font-size: 1.1rem;
    line-height: 1.3;
    color: var(--navy);
    text-wrap: balance;
  }
  .guide-card__excerpt {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.55;
    color: var(--ink-2);
    /* push the CTA to a consistent baseline */
    flex: 1 1 auto;
  }
  .guide-card__cta {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-weight: 700;
    font-size: 0.92rem;
    color: var(--brand);
  }
  .guide-card:hover .guide-card__cta {
    color: var(--brand-dark);
  }
</style>
