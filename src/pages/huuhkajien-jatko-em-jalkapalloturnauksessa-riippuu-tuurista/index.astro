---
// @custom — hand-edited page; converters/scrapers must not overwrite it.
//
// /huuhkajien-jatko-em-jalkapalloturnauksessa-riippuu-tuurista/ — football
// article (Euro 2020). MIGRATED to the LIGHT theme: the scraped fragment's
// dark sliced header / slide-menu / footer / sidebar are NO LONGER rendered —
// this page now wraps ArticlePage.astro, which supplies the light
// Header/Footer/DisclosureBar (via BaseLayout) and a light RelatedCasinos
// sidebar. We extract ONLY the article body (.wp-content-area) from the
// fragment, decode the ShortPixel SVG placeholders to real <img> URLs, soften
// any first-hand claims, inject ONE contextual "Lue myös" box pointing to
// /mm-kisat-2026-tilastot/, and hand the cleaned HTML to ArticlePage as
// bodyHtml.
//
// COMPLIANCE: the only affiliate /go/ links on the old page lived in the dark
// sliced sidebar, which is GONE — replaced by RelatedCasinos, whose CTAs are
// already rel="sponsored nofollow". The article prose itself contains only
// internal links. seoPath is forwarded so the indexed <head> (canonical /
// description / robots / OG / JSON-LD) is preserved VERBATIM (penalty recovery).
//
// Body-extraction is resilient: anchor on the article's stable .wp-content-area
// wrapper; if a re-scrape changes the markup we fall back to the full body so
// the page never throws.
import ArticlePage from "../../layouts/ArticlePage.astro";
import { scrubFirstHandClaims } from "../../lib/content";
import bodyHtml from "../../fragments/huuhkajien-jatko-em-jalkapalloturnauksessa-riippuu-tuurista/body.html?raw";

const seoPath = "/huuhkajien-jatko-em-jalkapalloturnauksessa-riippuu-tuurista/";
const title = "Huuhkajien jatko EM -jalkapalloturnauksessa riippuu tuurista – Euro 2020";
const siteUrl = "https://kasinotilmanrekisteroitymista.com";

/* ---- Extract just the article body from the scraped fragment ---- */
/* The article lives inside the FIRST <div class="wp-content-area"> … </div>.
   That div contains no nested <div>, so the first following </div> closes it. */
function extractArticle(src: string): string {
  const open = src.indexOf('<div class="wp-content-area">');
  if (open === -1) return src; // resilient: never throw, render whatever we have
  const inner = open + '<div class="wp-content-area">'.length;
  const close = src.indexOf("</div>", inner);
  if (close === -1) return src.slice(inner);
  return src.slice(inner, close);
}

/* ShortPixel adaptive images ship as base64 SVG placeholders; the real image
   URL sits URL-encoded in a data-u attribute INSIDE the encoded SVG. Decode at
   build time → a plain <img src> (root-relative), no spai script needed. */
function decodeSpai(html: string): string {
  return html.replace(
    /<img\b[^>]*src="data:image\/svg\+xml;base64,([^"]+)"[^>]*>/g,
    (tag, b64) => {
      const svg = Buffer.from(b64, "base64").toString("utf8");
      const dataU = svg.match(/data-u="([^"]+)"/)?.[1];
      if (!dataU) return tag;
      const real = decodeURIComponent(dataU).replace(siteUrl, "");
      return tag
        .replace(/src="data:[^"]*"/, `src="${real}"`)
        .replace(/\s+data-spai="[^"]*"/g, "");
    },
  );
}

/* ---- Contextual "Lue myös" box appended to the article body ---- */
/* Styled inline via the .kir-prose blockquote treatment already defined in
   ArticlePage (brand-soft callout, left brand rule) so it inherits the light
   theme without needing a head slot. */
const lueMyos = `
<aside class="kir-lue-myos" style="margin:2em 0 0;padding:1.1em 1.3em;background:var(--brand-soft);border:1px solid var(--line);border-left:4px solid var(--brand);border-radius:0 var(--radius-sm) var(--radius-sm) 0;">
\t<p style="margin:0;color:var(--ink-2);"><strong>Lue myös:</strong> Kesällä 2026 jalkapallon MM-turnaus pelataan Yhdysvalloissa, Kanadassa ja Meksikossa. Kokosimme yhteen <a href="/mm-kisat-2026-tilastot/">MM-kisojen 2026 tilastot ja lohkot</a> – mukana kaikki 48 joukkuetta, kaikkien aikojen parhaat maalintekijät ja MM-historian ennätykset.</p>
</aside>`;

let article = decodeSpai(extractArticle(bodyHtml));
/* Soften any first-person testing language before render (compliance). */
article = scrubFirstHandClaims(article);
/* Append the contextual cross-link at the end of the article body. */
article = article + lueMyos;

const breadcrumb = [
  { label: "Kasinot Ilman Rekisteröitymistä", href: "/" },
  { label: title, href: "" },
];

const relatedLinks = [
  { label: "MM-kisojen 2026 tilastot", href: "/mm-kisat-2026-tilastot/" },
  { label: "Uudet kasinot", href: "/uudet-kasinot/" },
  { label: "Kasinobonukset", href: "/kasinobonukset/" },
  { label: "Uutiset", href: "/uutiset/" },
];
---

<ArticlePage
  seoPath={seoPath}
  title={title}
  bodyHtml={article}
  date="2021-06-21"
  eyebrow="Jalkapallo"
  breadcrumb={breadcrumb}
  relatedLinks={relatedLinks}
/>
