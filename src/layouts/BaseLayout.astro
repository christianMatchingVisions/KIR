---
/**
 * BaseLayout.astro — the document shell every REBUILT (light-theme) page uses.
 *
 * Two head modes:
 *  1. seoPath given  → this URL corresponds to an existing, indexed page.
 *     We look up the PRESERVED SEO head from the Phase-1 registry and emit its
 *     canonical / description / robots / OpenGraph / Twitter / JSON-LD VERBATIM
 *     (penalty-recovery requirement — the rebuild must not look like a new
 *     site to Google). The registry's <title> is used unless an explicit
 *     `title` prop overrides it.
 *  2. no seoPath (brand-new hub pages) → build a clean head from the
 *     title / description / canonical / jsonLd props.
 *
 * BUILD-TIME GUARD: if a seoPath is provided but the SEO registry is empty,
 * we THROW. Phase 1 had a bug where the fragments dir failed to resolve at
 * build time and silently produced an EMPTY registry (every preserved head
 * vanished). Failing loudly here turns that silent SEO data-loss into a build
 * failure instead of a shipped regression.
 *
 * Always emits charset + viewport and preloads the Inter woff2. Renders
 * Header → <main><slot/></main> → Footer → DisclosureBar, and ships a tiny
 * IntersectionObserver that reveals `.reveal` elements (respecting
 * prefers-reduced-motion).
 */
import "../styles/base.css";
import { getSeoHead, renderSeoHeadHtml, listSeoPaths } from "../lib/seo-head";
import { shouldNoindex } from "../lib/noindex";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import DisclosureBar from "../components/DisclosureBar.astro";
import CroHook from "../components/CroHook.astro";
import AffiliateClickTracker from "../components/AffiliateClickTracker.astro";

interface Props {
  /** URL path of an EXISTING page → preserve its registered SEO head verbatim. */
  seoPath?: string;
  /** Page <title>. For seoPath pages this overrides the registry title only if set. */
  title?: string;
  /** Meta description (new pages, or override). */
  description?: string;
  /** Canonical URL (new pages). */
  canonical?: string;
  /** Raw JSON-LD <script> strings to inject (new pages). */
  jsonLd?: string[];
  /** Extra class(es) on <body>. */
  bodyClass?: string;
}

const {
  seoPath,
  title,
  description,
  canonical,
  jsonLd = [],
  bodyClass,
} = Astro.props;

// ---- Preserved-head lookup (penalty recovery) ----
const seo = seoPath ? getSeoHead(seoPath) : null;

// BUILD-TIME GUARD: a seoPath was requested but the whole registry is empty →
// the fragments data layer failed to load. Fail the build loudly.
if (seoPath && listSeoPaths().length === 0) {
  throw new Error(
    `[BaseLayout] SEO registry is EMPTY but seoPath="${seoPath}" was requested. ` +
      `This means src/fragments failed to resolve at build time and every ` +
      `preserved <head> would be silently dropped (a penalty-recovery regression). ` +
      `Refusing to build. Check seo-head.ts / fragment sync.`
  );
}

// Title resolution: explicit prop wins; else registry title; else site fallback.
const resolvedTitle =
  title ?? seo?.title ?? "Kasinot ilman rekisteröitymistä";

// ---- Centralized NOINDEX (findings H7-thin / L7) ----
// One source of truth (src/lib/noindex.ts) decides whether this path is a
// closed/stub casino review (or an explicit thin page). When true we emit
// exactly ONE <meta name="robots" content="noindex,follow"> and SUPPRESS any
// preserved index robots meta so there is never a duplicate/conflicting robots
// tag. Test against the page's real path: the preserved-head seoPath for
// existing pages, else the live request path for clean hub pages.
const pathForPolicy = seoPath ?? Astro.url.pathname;
const noindex = shouldNoindex(pathForPolicy);

// Discrete preserved-head HTML (canonical/desc/robots/og/twitter/jsonLd),
// VERBATIM — <title> intentionally omitted by renderSeoHeadHtml (layout owns it).
let preservedHeadHtml = seo ? renderSeoHeadHtml(seo) : "";
// When noindexing, strip the preserved robots <meta> from the verbatim blob so
// our explicit noindex,follow tag is the ONLY robots directive on the page.
// (Real/indexable pages never enter this branch → byte-faithful head intact.)
if (noindex && preservedHeadHtml) {
  // Tag-based (not line-based) removal: a line-eating regex would strip
  // unrelated content if the registry ever emitted two tags on one line.
  preservedHeadHtml = preservedHeadHtml.replace(
    /<meta[^>]*\bname=["']robots["'][^>]*>\s*/gi,
    "",
  );
}

// For NEW pages (no preserved head), decide which clean tags to emit.
const emitCleanCanonical = !seo && Boolean(canonical);
const emitCleanDescription = !seo && Boolean(description);
const cleanJsonLd = !seo ? jsonLd : [];

// ---- OG default for net-new hub pages (finding L2) ----
// /oppaat/ is a brand-new hub rendered without a preserved head and without its
// own OpenGraph data, so it gets a generic OG card (+ og:title + index robots)
// here. /toimitus/ is excluded: it supplies its OWN purpose-written og tags via
// the jsonLd head slot, so adding the default here would double the og:image.
// The 582 pages with preserved heads are untouched (seo is set, so this skips).
const normalizedPath = (() => {
  let s = pathForPolicy.split(/[?#]/)[0];
  if (!s.startsWith("/")) s = "/" + s;
  if (!s.endsWith("/")) s = s + "/";
  return s.replace(/\/{2,}/g, "/");
})();
const isOgDefaultHub = !seo && normalizedPath === "/oppaat/";
const ogDefaultImage = "https://kasinotilmanrekisteroitymista.com/og/default.png";
---

<!doctype html>
<html lang="fi">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{resolvedTitle}</title>

    {/* Site icon — clears the /favicon.ico 404. SVG primary, .ico fallback. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />

    {/* Search Console ownership — verbatim, on every page (BLOCKER B1). */}
    <meta
      name="google-site-verification"
      content="VXX94NK1YmFWwzr2QQFxmlmMdftME_eZpoRQyAjWL2w"
    />
    <meta
      name="google-site-verification"
      content="wXW2aTUpd0_NX4AHA_6TRpatd8RwUFUZ-zpqo1ZmV5w"
    />

    {/*
      Centralized noindex: closed/stub casino reviews + explicit thin paths get
      exactly one robots tag here; the preserved robots meta was stripped above
      so this is the sole directive (findings H7-thin / L7).
    */}
    {noindex && <meta name="robots" content="noindex,follow" />}

    {/* Preserved SEO head for existing pages — verbatim. */}
    {seo && <Fragment set:html={preservedHeadHtml} />}

    {/* OG default for net-new hubs lacking og data (finding L2). */}
    {
      isOgDefaultHub && (
        <>
          {!noindex && <meta name="robots" content="index,follow" />}
          <meta property="og:title" content={resolvedTitle} />
          <meta property="og:type" content="website" />
          <meta
            property="og:url"
            content={`https://kasinotilmanrekisteroitymista.com${normalizedPath}`}
          />
          <meta property="og:image" content={ogDefaultImage} />
          <meta name="twitter:card" content="summary_large_image" />
          <meta name="twitter:title" content={resolvedTitle} />
        </>
      )
    }

    {/* Clean head for new pages. */}
    {emitCleanCanonical && <link rel="canonical" href={canonical} />}
    {emitCleanDescription && <meta name="description" content={description} />}
    {cleanJsonLd.map((s) => <Fragment set:html={s} />)}

    {/* Fonts: preload the primary Inter woff2 for fast first paint. */}
    <link
      rel="preload"
      href="/fonts/inter-var-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta name="theme-color" content="#ffffff" />
  </head>
  <body class={bodyClass}>
    <a class="skip-link" href="#main">Siirry sisältöön</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <DisclosureBar />

    {/*
      Google Tag (GT-5DCRZLHV) + GA4 (G-72MZEB7RDD) — re-injected to match LIVE
      behaviour (BLOCKER B1). Offloaded to a Partytown web worker
      (type="text/partytown") so the tags run OFF the main thread and the
      rebuild keeps its 0-main-thread-JS Core Web Vitals profile. The inline
      bootstrap defines dataLayer/gtag before the loader runs; the loader is the
      standard gtag.js for the Google Tag container; config wires both IDs.
      NOTE (legal follow-up): live shipped NO cookie banner — parity-first. An
      EU/igaming consent CMP + Google Consent Mode decision is recommended.
    */}
    <script type="text/partytown" is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'GT-5DCRZLHV');
      gtag('config', 'G-72MZEB7RDD');
    </script>
    <script
      is:inline
      type="text/partytown"
      src="https://www.googletagmanager.com/gtag/js?id=GT-5DCRZLHV"
    ></script>

    {/*
      CRO/A-B hook (PostHog) — env-gated + consent-aware. INERT by default:
      renders NOTHING unless PUBLIC_POSTHOG_KEY is set at build time, so the
      default build ships no extra tracking, no cookies, and keeps the current
      consent posture. When enabled it runs cookieless (persistence:'memory',
      autocapture off, DNT respected) in a Partytown worker. See CroHook.astro.
    */}
    <CroHook />

    {/*
      Outbound affiliate-click measurement (GA4 `affiliate_click`). Main-thread,
      event-delegated, non-blocking; relies on Partytown's forwarded window.gtag.
      Measurement only — never alters rel="sponsored nofollow" or the href, and
      sends no personal data. See AffiliateClickTracker.astro.
    */}
    <AffiliateClickTracker />

    <script>
      // Reveal-on-scroll: add .in to .reveal elements as they enter the
      // viewport. Respects prefers-reduced-motion (base.css already shows
      // .reveal at full opacity in that case, but we also reveal immediately).
      (() => {
        const els = Array.from(document.querySelectorAll<HTMLElement>(".reveal"));
        if (!els.length) return;

        const reduce = window.matchMedia(
          "(prefers-reduced-motion: reduce)"
        ).matches;

        if (reduce || !("IntersectionObserver" in window)) {
          els.forEach((el) => el.classList.add("in"));
          return;
        }

        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("in");
                obs.unobserve(entry.target);
              }
            }
          },
          // threshold:0 so elements taller than the viewport (e.g. long money-
          // page prose) still reveal — a ratio-based threshold can never be met
          // by a 15000px block and would leave it permanently hidden.
          { rootMargin: "0px 0px -8% 0px", threshold: 0 }
        );
        els.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: 0.75rem;
    top: -3rem;
    z-index: 300;
    padding: 0.6rem 1rem;
    background: var(--navy);
    color: #fff;
    border-radius: var(--radius-sm);
    font-weight: 700;
    text-decoration: none;
    transition: top 0.18s ease;
  }
  .skip-link:focus-visible {
    top: 0.75rem;
    color: #fff;
  }

  main {
    display: block;
    min-height: 40vh;
  }
</style>
