---
/**
 * CasinoInfoGrid.astro — the "Tietoa kasinosta <Name>" definition grid.
 *
 * A <dl> of present-fields-only rows:
 *   - Perustettu      (foundedYear)
 *   - Lisenssi        (license)
 *   - Maksutavat      (paymentMethods joined)
 *   - Minimitalletus  (minDeposit)
 *   - Asiakaspalvelu  (support: email / phone / live chat — summarised)
 *   - Verkkosivusto   (link to /go/<ctaSlug>/, rel="sponsored nofollow")
 *
 * Each row is skipped when its field is missing; the whole section is omitted
 * if no row has data. When there are only a few rows the grid uses a compact
 * two-column layout so it never leaves a tall empty card. No fabricated values.
 *
 * COMPLIANCE: the "Verkkosivusto" link is the /go/ affiliate path and always
 * carries rel="sponsored nofollow".
 *
 * Props:
 *   review : CasinoReview
 *   title? : string  (default `Tietoa kasinosta <name>`)
 */
import type { CasinoReview } from "../../lib/casino-data";

interface Props {
  review: CasinoReview;
  title?: string;
}

const { review, title } = Astro.props;
const {
  name,
  ctaSlug,
  foundedYear,
  license,
  paymentMethods,
  minDeposit,
  support,
} = review;

// "Tietoa kasinosta <Name>" — avoids the broken "<Name>:sta" colon-suffix
// (correct Finnish elative case can't be auto-generated for arbitrary names).
const heading = title ?? `Tietoa kasinosta ${name}`;

const hasCta = typeof ctaSlug === "string" && ctaSlug.length > 0;
const ctaHref = hasCta ? `/go/${ctaSlug}/` : null;

/* Build the support value from whatever channels we actually have. */
function supportValue(): string | null {
  if (!support) return null;
  const parts: string[] = [];
  if (support.liveChat === true) parts.push("Live-chat");
  if (support.email) parts.push(support.email);
  if (support.phone && support.phone !== "Kyllä") parts.push(support.phone);
  else if (support.phone === "Kyllä") parts.push("Puhelintuki");
  return parts.length ? parts.join(" · ") : null;
}

/** A row's value is either plain text or a sponsored affiliate link. */
type Row = { label: string; value: string; href?: string };
const rows: Row[] = [];

if (foundedYear && foundedYear.trim().length > 0) {
  rows.push({ label: "Perustettu", value: foundedYear });
}
if (license && license.trim().length > 0) {
  rows.push({ label: "Lisenssi", value: license });
}
if (paymentMethods.length > 0) {
  rows.push({ label: "Maksutavat", value: paymentMethods.join(", ") });
}
if (minDeposit && minDeposit.trim().length > 0) {
  rows.push({ label: "Minimitalletus", value: minDeposit });
}
const sv = supportValue();
if (sv) rows.push({ label: "Asiakaspalvelu", value: sv });
if (hasCta) {
  rows.push({ label: "Verkkosivusto", value: `Siirry ${name}`, href: ctaHref! });
}

// Compact two-column layout when the list is short, so it never leaves a tall
// empty card; a longer list reads as a single clean definition list.
const compact = rows.length <= 4;
---

{rows.length > 0 && (
  <section class="ig" aria-label={heading}>
    <h2 class="ig__title">{heading}</h2>
    <dl class="ig__grid card" class:list={[{ "ig__grid--compact": compact }]}>
      {rows.map((r) => (
        <div class="ig__row">
          <dt class="ig__label">{r.label}</dt>
          <dd class="ig__value">
            {r.href ? (
              <a class="ig__link" href={r.href} rel="sponsored nofollow">{r.value}</a>
            ) : (
              r.value
            )}
          </dd>
        </div>
      ))}
    </dl>
  </section>
)}

<style>
  .ig {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .ig__title {
    margin: 0;
  }
  .ig__grid {
    margin: 0;
    padding: 0.4rem 1.25rem;
  }
  .ig__row {
    display: grid;
    grid-template-columns: minmax(120px, 0.45fr) 1fr;
    gap: 0.5rem 1.25rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
    align-items: baseline;
  }
  .ig__row:last-child {
    border-bottom: 0;
  }
  .ig__link {
    color: var(--brand);
    font-weight: 700;
    text-decoration: none;
  }
  .ig__link:hover {
    color: var(--brand-dark);
    text-decoration: underline;
  }

  /* Compact: 2 rows per line on wide screens so a short list stays tidy. */
  @media (min-width: 620px) {
    .ig__grid--compact {
      display: grid;
      grid-template-columns: 1fr 1fr;
      column-gap: 2rem;
      padding-block: 0.9rem;
    }
    .ig__grid--compact .ig__row {
      border-bottom: 1px solid var(--line);
    }
    /* Drop the bottom border on the last row of each column. */
    .ig__grid--compact .ig__row:last-child,
    .ig__grid--compact .ig__row:nth-last-child(2):nth-child(odd) {
      border-bottom: 0;
    }
  }
  .ig__label {
    margin: 0;
    font-size: 0.78rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
  }
  .ig__value {
    margin: 0;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.4;
    overflow-wrap: anywhere;
  }

  @media (max-width: 480px) {
    .ig__row {
      grid-template-columns: 1fr;
      gap: 0.15rem;
    }
  }
</style>
