---
/**
 * GameProviders.astro — the "Pelivalmistajat" (game/software providers) section.
 *
 * Providers come from CasinoReview.providers, which is whitelist-extracted from
 * the review prose (parseProviders in casino-data.ts) — only studios the casino
 * actually names, never fabricated. Rendered as clean name pills (no provider
 * logos are bundled, so names keep it honest and dependency-free). The whole
 * section is omitted when the list is empty.
 *
 * Props:
 *   providers : string[]   (CasinoReview.providers)
 *   title?    : string     (default "Pelivalmistajat")
 */
import Icon from "../Icon.astro";

interface Props {
  providers: string[];
  title?: string;
}

const { providers, title = "Pelivalmistajat" } = Astro.props;
const list = (providers ?? []).filter((p) => p && p.trim().length > 0);
---

{list.length > 0 && (
  <section class="gp" aria-label={title}>
    <h2 class="gp__title">{title}</h2>
    <ul class="gp__list">
      {list.map((name) => (
        <li class="gp__pill">
          <Icon name="dice" size={15} class="gp__ico" />
          <span class="gp__name">{name}</span>
        </li>
      ))}
    </ul>
    <p class="gp__note">
      Pelivalikoima koostuu yllä olevien tunnettujen pelivalmistajien peleistä.
      Saatavilla oleva valikoima voi vaihdella ajan ja sijainnin mukaan.
    </p>
  </section>
)}

<style>
  .gp {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }
  .gp__title {
    margin: 0;
  }
  .gp__list {
    display: flex;
    flex-wrap: wrap;
    gap: clamp(0.5rem, 0.35rem + 0.5vw, 0.7rem);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .gp__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.5rem 0.85rem;
    background: var(--bg);
    border: 1px solid var(--line);
    border-radius: 999px;
    transition: border-color 0.18s ease, box-shadow 0.18s ease, transform 0.18s ease;
  }
  .gp__pill:hover {
    border-color: var(--brand);
    box-shadow: var(--shadow-sm);
    transform: translateY(-1px);
  }
  .gp__ico {
    color: var(--brand);
    flex: none;
  }
  .gp__name {
    font-weight: 700;
    font-size: 0.9rem;
    color: var(--ink);
    line-height: 1.2;
    white-space: nowrap;
  }
  .gp__note {
    margin: 0.2rem 0 0;
    font-size: 0.85rem;
    color: var(--ink-3);
    line-height: 1.5;
    max-width: 64ch;
  }
</style>
