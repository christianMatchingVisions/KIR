---
/**
 * HomeHero.astro — light-theme homepage hero (Arctic Day).
 *
 * Two-column on desktop (text ~55% left, original CSS/SVG casino visual ~45%
 * right), stacked on mobile, on a light-blue gradient band.
 *
 * The RIGHT-side composition is built entirely from inline SVG + CSS — NO
 * raster/photo assets. It is a premium, crafted casino still-life:
 *   - a soft atmospheric backdrop (blurred brand + gold blobs, concentric
 *     guide rings, faint dot grid) so the pieces sit in light, not on blank
 *     blue;
 *   - a STACK of four poker chips with real edge ridges, top sheen and a
 *     glossy highlight arc, anchored bottom-left;
 *   - a FAN of two playing cards (ace of spades + a red king) with rounded
 *     corners, inner bevel and a soft sheen;
 *   - a GOLD coin (tied to the yellow CTA) with embossed "+" brand motif and
 *     specular highlight;
 *   - a small floating blue chip and a die for balance;
 *   - scattered sparkle/shine accents and the brand "+" integrated tastefully.
 * Depth comes from layered drop-shadows, z-index ordering and overlap.
 *
 * Material/dimensionality is achieved with SVG <radialGradient>/<linearGradient>
 * defs (glossy highlights, darker rims, top sheen) rather than flat fills.
 *
 * The headline highlights `accentWord` in --brand. Three trust pills use the
 * shared <Icon> chip pattern. CTA is a yellow .btn-cta that anchors down to the
 * toplist section (#parhaat by default).
 *
 * All float/parallax/shine motion is CSS @keyframes, fully disabled under
 * prefers-reduced-motion. The visual shrinks then hides on small screens so the
 * hero never causes horizontal overflow down to 360px.
 *
 * Props are all optional with Finnish defaults from the reference design.
 */
import Icon from "./Icon.astro";
import fs from "node:fs";
import path from "node:path";

/**
 * Premium hero illustration: if a raster render exists in public/hero/
 * (lion-slot.webp|png|jpg), use it; otherwise fall back to the inline CSS/SVG
 * casino still-life. Drop the file in → it switches automatically, no code change.
 */
const HERO_IMG_CANDIDATES = ["lion-slot.webp", "lion-slot.png", "lion-slot.jpg", "lion-slot.jpeg"];
const heroImageSrc: string | null = (() => {
  const dir = path.join(process.cwd(), "public", "hero");
  for (const f of HERO_IMG_CANDIDATES) {
    try { if (fs.existsSync(path.join(dir, f))) return `/hero/${f}`; } catch { /* ignore */ }
  }
  return null;
})();

interface Props {
  /** H1 lead text BEFORE the accent word. */
  headline?: string;
  /** Final word of the H1, rendered in --brand. */
  accentWord?: string;
  /** Sub-paragraph under the headline. */
  subtext?: string;
  /** CTA button label. */
  ctaLabel?: string;
  /** CTA href (defaults to the on-page toplist anchor). */
  ctaHref?: string;
}

const {
  headline = "Pelaa parhailla kasinolla ilman",
  accentWord = "rekisteröitymistä",
  subtext =
    "Kasino ilman rekisteröitymistä on nettikasino, jolla pelaaminen, talletukset ja kotiutukset hoituvat verkkopankkitunnuksilla (Trustly, Zimpler tai BRITE) ilman erillistä tilin luontia. Vertailemme alta lisensoidut, suomalaisille sopivat pikakasinot.",
  ctaLabel = "Katso parhaat kasinot",
  ctaHref = "#parhaat",
} = Astro.props as Props;

// Trust pills: round --brand-soft icon chip + bold navy label + tiny sublabel.
const pills = [
  { icon: "bolt", label: "Pelaa heti", sub: "Ilman rekisteröitymistä" },
  { icon: "shield", label: "Turvallista", sub: "Luotettavat kasinot" },
  { icon: "gift", label: "Parhaat bonukset", sub: "Eksklusiiviset edut" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    {/* ---------- LEFT: copy + pills + CTA ---------- */}
    <div class="hero__copy reveal">
      <h1 id="hero-title" class="hero__title">
        {headline}{" "}<span class="hero__accent">{accentWord}</span>
      </h1>

      <p class="hero__subtext lead">{subtext}</p>

      <ul class="hero__pills" role="list">
        {pills.map((p) => (
          <li class="pill">
            <span class="pill__chip" aria-hidden="true">
              <Icon name={p.icon} size={20} />
            </span>
            <span class="pill__text">
              <span class="pill__label">{p.label}</span>
              <span class="pill__sub">{p.sub}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="hero__cta">
        <a class="btn-cta btn-lg" href={ctaHref}>
          {ctaLabel}
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>

    {/* ---------- RIGHT: premium illustration — raster image if present in
         public/hero/, otherwise the inline CSS/SVG casino still-life ---------- */}
    <div class:list={["hero__visual", "reveal", "d2", heroImageSrc && "hero__visual--img"]}>
      {heroImageSrc ? (
        <img
          class="hero__img"
          src={heroImageSrc}
          width="917"
          height="813"
          alt="Iloinen kasinomaskotti juhlii kolikkopelin ja pelimerkkien äärellä"
          decoding="async"
          fetchpriority="high"
        />
      ) : (
      <div class="stage" aria-hidden="true">
        {/* ---- Atmosphere: blurred brand + gold blobs ---- */}
        <span class="blob blob--brand"></span>
        <span class="blob blob--gold"></span>
        <span class="blob blob--soft"></span>

        {/* ---- Concentric guide rings + faint dot grid + big "+" ---- */}
        <svg class="atmos" viewBox="0 0 400 400" width="400" height="400" focusable="false" preserveAspectRatio="xMidYMid slice">
          <defs>
            <radialGradient id="hh-ring" cx="50%" cy="46%" r="55%">
              <stop offset="0%" stop-color="var(--brand)" stop-opacity="0"></stop>
              <stop offset="70%" stop-color="var(--brand)" stop-opacity="0"></stop>
              <stop offset="100%" stop-color="var(--brand)" stop-opacity="0.10"></stop>
            </radialGradient>
            <pattern id="hh-dots" width="22" height="22" patternUnits="userSpaceOnUse">
              <circle cx="2" cy="2" r="1.4" fill="var(--brand)" opacity="0.10"></circle>
            </pattern>
          </defs>

          {/* faint dot grid, masked to a soft disc so it fades at the edges */}
          <circle cx="200" cy="186" r="180" fill="url(#hh-dots)"></circle>

          {/* concentric rings */}
          <g fill="none" stroke="var(--brand)" stroke-opacity="0.12">
            <circle cx="200" cy="186" r="168" stroke-width="1.5"></circle>
            <circle cx="200" cy="186" r="128" stroke-width="1.5" stroke-dasharray="2 8"></circle>
          </g>
          <circle cx="200" cy="186" r="180" fill="url(#hh-ring)"></circle>

          {/* integrated brand "+" motif, upper-right, tasteful weight */}
          <path d="M312 70v44M290 92h44" stroke="var(--brand)" stroke-width="9"
            stroke-linecap="round" stroke-opacity="0.16"></path>
          <path d="M70 280v30M55 295h30" stroke="var(--cta-hover)" stroke-width="7"
            stroke-linecap="round" stroke-opacity="0.45"></path>
        </svg>

        {/* ================= SVG STILL-LIFE =================
            One SVG holds the gradient-shaded "material" pieces so highlights,
            rims and sheens share a coordinate space. Floating wrappers around
            each <use>-like group give per-element parallax. ================= */}

        {/* ---- shared gradient defs ---- */}
        <svg class="defs" width="0" height="0" aria-hidden="true" focusable="false">
          <defs>
            {/* blue chip body: lit from top-left */}
            <radialGradient id="hh-chip-blue" cx="38%" cy="32%" r="78%">
              <stop offset="0%" stop-color="#5a9bff"></stop>
              <stop offset="45%" stop-color="var(--brand)"></stop>
              <stop offset="100%" stop-color="var(--brand-dark)"></stop>
            </radialGradient>
            {/* blue chip rim (darker edge) */}
            <linearGradient id="hh-chip-blue-rim" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#1657c4"></stop>
              <stop offset="100%" stop-color="#0e3f96"></stop>
            </linearGradient>
            {/* gold coin body */}
            <radialGradient id="hh-gold" cx="36%" cy="30%" r="82%">
              <stop offset="0%" stop-color="#fff3c4"></stop>
              <stop offset="40%" stop-color="var(--cta)"></stop>
              <stop offset="100%" stop-color="#e0a900"></stop>
            </radialGradient>
            <linearGradient id="hh-gold-rim" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#f5c200"></stop>
              <stop offset="100%" stop-color="#b88600"></stop>
            </linearGradient>
            {/* white/light chip */}
            <radialGradient id="hh-chip-white" cx="38%" cy="30%" r="80%">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="100%" stop-color="#e7eefb"></stop>
            </radialGradient>
            {/* card face sheen */}
            <linearGradient id="hh-card" x1="0" y1="0" x2="0.7" y2="1">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="55%" stop-color="#fbfdff"></stop>
              <stop offset="100%" stop-color="#eef3fb"></stop>
            </linearGradient>
            {/* glossy diagonal highlight on cards/chips */}
            <linearGradient id="hh-gloss" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffffff" stop-opacity="0.85"></stop>
              <stop offset="40%" stop-color="#ffffff" stop-opacity="0.10"></stop>
              <stop offset="100%" stop-color="#ffffff" stop-opacity="0"></stop>
            </linearGradient>
            {/* die body */}
            <linearGradient id="hh-die" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%" stop-color="#ffffff"></stop>
              <stop offset="100%" stop-color="#e9eefa"></stop>
            </linearGradient>
          </defs>
        </svg>

        {/* ---- FAN of two playing cards (center-back) ---- */}
        <div class="piece cards float-cards">
          {/* back card: red king, fanned right */}
          <svg class="card card--back" viewBox="0 0 132 184" width="132" height="184" focusable="false">
            <rect x="2" y="2" width="128" height="180" rx="16" fill="url(#hh-card)"
              stroke="var(--line-2)" stroke-width="1.5"></rect>
            <rect x="7" y="7" width="118" height="170" rx="12" fill="none"
              stroke="#fff" stroke-width="1.5" opacity="0.9"></rect>
            <g fill="var(--bad)" font-family="var(--font)" font-weight="800">
              <text x="16" y="34" font-size="24">K</text>
              <text x="116" y="166" font-size="24" text-anchor="end"
                transform="rotate(180 110 160)">K</text>
            </g>
            {/* heart corner pips */}
            <path class="pip" d="M19 41c-2-3-7-2-7 2 0 3 3 5 7 9 4-4 7-6 7-9 0-4-5-5-7-2Z" fill="var(--bad)"></path>
            <path class="pip" d="M113 143c2 3 7 2 7-2 0-3-3-5-7-9-4 4-7 6-7 9 0 4 5 5 7 2Z" fill="var(--bad)"
              transform="rotate(180 110 160)"></path>
            {/* center heart */}
            <path d="M66 76c-7-12-26-9-26 7 0 14 17 24 26 33 9-9 26-19 26-33 0-16-19-19-26-7Z"
              fill="var(--bad)" opacity="0.92"></path>
            {/* sheen */}
            <rect x="2" y="2" width="128" height="180" rx="16" fill="url(#hh-gloss)" opacity="0.5"></rect>
          </svg>

          {/* front card: ace of spades, fanned left */}
          <svg class="card card--front" viewBox="0 0 132 184" width="132" height="184" focusable="false">
            <rect x="2" y="2" width="128" height="180" rx="16" fill="url(#hh-card)"
              stroke="var(--line-2)" stroke-width="1.5"></rect>
            <rect x="7" y="7" width="118" height="170" rx="12" fill="none"
              stroke="#fff" stroke-width="1.5" opacity="0.9"></rect>
            <g fill="var(--navy)" font-family="var(--font)" font-weight="800">
              <text x="16" y="34" font-size="24">A</text>
              <text x="116" y="166" font-size="24" text-anchor="end"
                transform="rotate(180 110 160)">A</text>
            </g>
            {/* big centred spade pip */}
            <path d="M66 60c0 0-30 22-30 41a15 15 0 0 0 24 11c0 7-2 11-6 14h24c-4-3-6-7-6-14a15 15 0 0 0 24-11c0-19-30-41-30-41Z"
              fill="var(--navy)"></path>
            {/* corner spades */}
            <path class="pip" d="M19 39c0 0-7 5-7 9a3.5 3.5 0 0 0 5.6 2.7c0 1.6-.5 2.4-1.3 3.3h5.4c-.8-.9-1.3-1.7-1.3-3.3A3.5 3.5 0 0 0 26 48c0-4-7-9-7-9Z" fill="var(--navy)"></path>
            <path class="pip" d="M113 145c0 0-7 5-7 9a3.5 3.5 0 0 0 5.6 2.7c0 1.6-.5 2.4-1.3 3.3h5.4c-.8-.9-1.3-1.7-1.3-3.3A3.5 3.5 0 0 0 120 154c0-4-7-9-7-9Z" fill="var(--navy)"
              transform="rotate(180 110 160)"></path>
            {/* sheen */}
            <rect x="2" y="2" width="128" height="180" rx="16" fill="url(#hh-gloss)" opacity="0.6"></rect>
          </svg>
        </div>

        {/* ---- STACK of poker chips (anchor, bottom-left) ---- */}
        <div class="piece chip-stack float-stack">
          <svg viewBox="0 0 150 150" width="150" height="150" focusable="false">
            {/* helper: each chip = ellipse body + rim + top face. Drawn bottom→top. */}
            {/* chip 4 (bottom) */}
            <g class="chip-layer">
              <ellipse cx="75" cy="116" rx="60" ry="20" fill="url(#hh-chip-blue-rim)"></ellipse>
              <ellipse cx="75" cy="110" rx="60" ry="20" fill="url(#hh-chip-blue)"></ellipse>
            </g>
            {/* chip 3 */}
            <g class="chip-layer">
              <ellipse cx="75" cy="102" rx="60" ry="20" fill="url(#hh-gold-rim)"></ellipse>
              <ellipse cx="75" cy="96" rx="60" ry="20" fill="url(#hh-gold)"></ellipse>
            </g>
            {/* chip 2 */}
            <g class="chip-layer">
              <ellipse cx="75" cy="88" rx="60" ry="20" fill="url(#hh-chip-blue-rim)"></ellipse>
              <ellipse cx="75" cy="82" rx="60" ry="20" fill="url(#hh-chip-blue)"></ellipse>
            </g>
            {/* chip 1 (top, detailed face) */}
            <g class="chip-layer">
              <ellipse cx="75" cy="74" rx="60" ry="20" fill="url(#hh-chip-blue-rim)"></ellipse>
              <ellipse cx="75" cy="68" rx="60" ry="20" fill="url(#hh-chip-blue)"></ellipse>
              {/* edge ridges on the top face rim */}
              <g fill="#ffffff" opacity="0.92">
                <ellipse cx="22" cy="68" rx="3" ry="7"></ellipse>
                <ellipse cx="42" cy="62" rx="3.5" ry="9"></ellipse>
                <ellipse cx="75" cy="59" rx="4" ry="9.5"></ellipse>
                <ellipse cx="108" cy="62" rx="3.5" ry="9"></ellipse>
                <ellipse cx="128" cy="68" rx="3" ry="7"></ellipse>
              </g>
              {/* inner dashed ring + hub */}
              <ellipse cx="75" cy="68" rx="40" ry="13" fill="none" stroke="#ffffff"
                stroke-width="2" stroke-dasharray="3 5" opacity="0.8"></ellipse>
              <ellipse cx="75" cy="68" rx="22" ry="8" fill="#ffffff" opacity="0.92"></ellipse>
              {/* tiny "+" brand mark in the hub */}
              <path d="M75 63v10M70 68h10" stroke="var(--brand)" stroke-width="2.4"
                stroke-linecap="round"></path>
              {/* glossy top sheen */}
              <ellipse cx="62" cy="63" rx="34" ry="9" fill="#ffffff" opacity="0.28"></ellipse>
            </g>
          </svg>
        </div>

        {/* ---- GOLD coin (top-right, ties to CTA) ---- */}
        <div class="piece coin float-coin">
          <svg viewBox="0 0 96 96" width="96" height="96" focusable="false">
            <circle cx="48" cy="48" r="46" fill="url(#hh-gold-rim)"></circle>
            <circle cx="48" cy="48" r="41" fill="url(#hh-gold)"></circle>
            <circle cx="48" cy="48" r="41" fill="none" stroke="#fff3c4"
              stroke-width="1.5" opacity="0.5"></circle>
            <circle cx="48" cy="48" r="30" fill="none" stroke="#b88600"
              stroke-width="1.5" stroke-dasharray="3 5" opacity="0.7"></circle>
            {/* embossed "+" brand motif */}
            <path d="M48 32v32M32 48h32" stroke="#8a6500" stroke-width="6"
              stroke-linecap="round" opacity="0.65"></path>
            <path d="M48 31v32M31 47h32" stroke="#fff3c4" stroke-width="3"
              stroke-linecap="round" opacity="0.6"></path>
            {/* specular highlight */}
            <ellipse cx="34" cy="32" rx="16" ry="10" fill="#ffffff" opacity="0.4"
              transform="rotate(-30 34 32)"></ellipse>
          </svg>
        </div>

        {/* ---- small floating blue chip (right) ---- */}
        <div class="piece chip-fly float-chip">
          <svg viewBox="0 0 76 76" width="76" height="76" focusable="false">
            <circle cx="38" cy="38" r="36" fill="url(#hh-chip-blue-rim)"></circle>
            <circle cx="38" cy="38" r="31" fill="url(#hh-chip-blue)"></circle>
            <g fill="#ffffff" opacity="0.95">
              <rect x="34" y="2" width="8" height="11" rx="2"></rect>
              <rect x="34" y="63" width="8" height="11" rx="2"></rect>
              <rect x="2" y="34" width="11" height="8" rx="2"></rect>
              <rect x="63" y="34" width="11" height="8" rx="2"></rect>
              <rect x="34" y="2" width="8" height="11" rx="2" transform="rotate(45 38 38)"></rect>
              <rect x="34" y="2" width="8" height="11" rx="2" transform="rotate(135 38 38)"></rect>
              <rect x="34" y="2" width="8" height="11" rx="2" transform="rotate(225 38 38)"></rect>
              <rect x="34" y="2" width="8" height="11" rx="2" transform="rotate(315 38 38)"></rect>
            </g>
            <circle cx="38" cy="38" r="20" fill="none" stroke="#ffffff" stroke-width="2"
              stroke-dasharray="3 5" opacity="0.85"></circle>
            <circle cx="38" cy="38" r="13" fill="#ffffff" opacity="0.92"></circle>
            <path d="M38 32l2.4 4.9 5.4.5-4 3.6 1.1 5.3L38 43.8 33.1 46.8l1.1-5.3-4-3.6 5.4-.5Z"
              fill="var(--brand)"></path>
            {/* top sheen */}
            <ellipse cx="30" cy="26" rx="16" ry="9" fill="#ffffff" opacity="0.3"></ellipse>
          </svg>
        </div>

        {/* ---- Die (lower-right) ---- */}
        <div class="piece die float-die">
          <svg viewBox="0 0 64 64" width="64" height="64" focusable="false">
            <rect x="3" y="3" width="58" height="58" rx="15" fill="url(#hh-die)"
              stroke="var(--line-2)" stroke-width="1.5"></rect>
            <rect x="7" y="7" width="50" height="50" rx="11" fill="none" stroke="#fff"
              stroke-width="1.5" opacity="0.9"></rect>
            <g fill="var(--navy)">
              <circle cx="20" cy="20" r="4.5"></circle>
              <circle cx="44" cy="20" r="4.5"></circle>
              <circle cx="20" cy="44" r="4.5"></circle>
              <circle cx="44" cy="44" r="4.5"></circle>
              <circle cx="32" cy="32" r="4.5"></circle>
            </g>
            <rect x="3" y="3" width="58" height="58" rx="15" fill="url(#hh-gloss)" opacity="0.55"></rect>
          </svg>
        </div>

        {/* ---- sparkle / shine accents ---- */}
        <svg class="sparkle sparkle--1 twinkle-a" viewBox="0 0 24 24" width="24" height="24" focusable="false">
          <path d="M12 0l2.2 8.6L24 12l-9.8 3.4L12 24l-2.2-8.6L0 12l9.8-3.4Z" fill="var(--cta)"></path>
        </svg>
        <svg class="sparkle sparkle--2 twinkle-b" viewBox="0 0 24 24" width="24" height="24" focusable="false">
          <path d="M12 0l2.2 8.6L24 12l-9.8 3.4L12 24l-2.2-8.6L0 12l9.8-3.4Z" fill="var(--brand)"></path>
        </svg>
        <svg class="sparkle sparkle--3 twinkle-c" viewBox="0 0 24 24" width="24" height="24" focusable="false">
          <path d="M12 0l2.2 8.6L24 12l-9.8 3.4L12 24l-2.2-8.6L0 12l9.8-3.4Z" fill="var(--cta)"></path>
        </svg>
      </div>
      )}
    </div>
  </div>
</section>

<style>
  /* ---------- Band: light-blue gradient ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-band) 0%, var(--bg-band-2) 100%);
    border-bottom: 1px solid var(--line);
    /* Compact, near-constant height across widths so the full first offer row
       sits above the fold on common screens (not width-scaled vw padding). */
    padding-block: clamp(16px, 0.9rem + 0.3vw, 24px);
  }

  /* Premium raster illustration (lion + slot machine), used when present.
     The background is cut out (transparent webp), so it sits flush on the band. */
  .hero__visual--img {
    display: grid;
    place-items: center;
  }
  .hero__img {
    display: block;
    width: 100%;
    max-width: 340px;
    height: auto;
    margin-inline: auto;
    filter: drop-shadow(0 26px 42px rgba(11, 31, 58, 0.16));
    animation: heroImgFloat 7s ease-in-out infinite;
  }
  @keyframes heroImgFloat {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero__img { animation: none; }
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  /* ---------- LEFT copy ---------- */
  .hero__title {
    /* capped so the headline height is consistent across widths */
    font-size: clamp(1.6rem, 1.1rem + 1.5vw, 2.3rem);
    line-height: 1.1;
    color: var(--navy);
    margin-bottom: 0.35em;
  }
  .hero__accent {
    color: var(--brand);
  }
  .hero__subtext {
    max-width: 44ch;
    font-size: 0.98rem;
    color: var(--ink-2);
    margin-bottom: 1rem;
  }

  /* Trust pills */
  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem 1.25rem;
    margin-bottom: 1.1rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .pill__chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand);
  }
  .pill__text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .pill__label {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .pill__sub {
    font-size: 0.78rem;
