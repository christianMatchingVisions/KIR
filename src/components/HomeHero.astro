---
/**
 * HomeHero.astro — light-theme homepage hero (Arctic Day).
 *
 * Two-column on desktop (text ~55% left, original CSS/SVG casino visual ~45%
 * right), stacked on mobile, on a light-blue gradient band with a faint large
 * "+" cross watermark. NO raster/photo assets — the right-side composition is
 * built entirely from inline SVG + CSS (floating poker chips, a stylized
 * ace/spade card, a die, soft --brand-soft blurred blobs).
 *
 * The headline highlights `accentWord` in --brand. Three trust pills use the
 * shared <Icon> chip pattern. CTA is a yellow .btn-cta that anchors down to the
 * toplist section (#parhaat by default).
 *
 * All float/parallax motion is CSS @keyframes, fully disabled under
 * prefers-reduced-motion. The visual shrinks then hides on small screens so the
 * hero never causes horizontal overflow down to 360px.
 *
 * Props are all optional with Finnish defaults from the reference design.
 */
import Icon from "./Icon.astro";

interface Props {
  /** H1 lead text BEFORE the accent word. */
  headline?: string;
  /** Final word of the H1, rendered in --brand. */
  accentWord?: string;
  /** Sub-paragraph under the headline. */
  subtext?: string;
  /** CTA button label. */
  ctaLabel?: string;
  /** CTA href (defaults to the on-page toplist anchor). */
  ctaHref?: string;
}

const {
  headline = "Pelaa parhailla kasinolla ilman",
  accentWord = "rekisteröitymistä",
  subtext =
    "Nopea, helppo ja turvallinen tapa pelata. Aloita pelaaminen heti ilman turhia lomakkeita – vain muutamassa sekunnissa.",
  ctaLabel = "Katso parhaat kasinot",
  ctaHref = "#parhaat",
} = Astro.props;

// Trust pills: round --brand-soft icon chip + bold navy label + tiny sublabel.
const pills = [
  { icon: "bolt", label: "Pelaa heti", sub: "Ilman rekisteröitymistä" },
  { icon: "shield", label: "Turvallista", sub: "Luotettavat kasinot" },
  { icon: "gift", label: "Parhaat bonukset", sub: "Eksklusiiviset edut" },
] as const;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero__grid">
    {/* ---------- LEFT: copy + pills + CTA ---------- */}
    <div class="hero__copy reveal">
      <h1 id="hero-title" class="hero__title">
        {headline}{" "}<span class="hero__accent">{accentWord}</span>
      </h1>

      <p class="hero__subtext lead">{subtext}</p>

      <ul class="hero__pills" role="list">
        {pills.map((p) => (
          <li class="pill">
            <span class="pill__chip" aria-hidden="true">
              <Icon name={p.icon} size={20} />
            </span>
            <span class="pill__text">
              <span class="pill__label">{p.label}</span>
              <span class="pill__sub">{p.sub}</span>
            </span>
          </li>
        ))}
      </ul>

      <div class="hero__cta">
        <a class="btn-cta btn-lg" href={ctaHref}>
          {ctaLabel}
          <Icon name="arrow-right" size={20} />
        </a>
      </div>
    </div>

    {/* ---------- RIGHT: original CSS/SVG casino composition ---------- */}
    <div class="hero__visual reveal d2" aria-hidden="true">
      <div class="stage">
        {/* soft blurred --brand-soft blobs behind everything */}
        <span class="blob blob--a"></span>
        <span class="blob blob--b"></span>

        {/* faint large "+" cross watermark */}
        <svg class="cross" viewBox="0 0 200 200" width="200" height="200" focusable="false">
          <path
            d="M100 30v140M30 100h140"
            stroke="var(--brand)"
            stroke-width="20"
            stroke-linecap="round"
            opacity="0.08"
          ></path>
        </svg>

        {/* Stylized ace-of-spades playing card (center) */}
        <div class="card-piece float-card">
          <svg viewBox="0 0 120 168" width="120" height="168" focusable="false" class="playing-card">
            <rect x="2" y="2" width="116" height="164" rx="14" fill="#ffffff"
              stroke="var(--line-2)" stroke-width="2"></rect>
            <g fill="var(--navy)">
              <text x="14" y="28" font-family="var(--font)" font-weight="800" font-size="22">A</text>
              <text x="106" y="150" font-family="var(--font)" font-weight="800" font-size="22"
                text-anchor="end" transform="rotate(180 100 144)">A</text>
            </g>
            {/* big centred spade pip */}
            <path
              d="M60 52c0 0-26 19-26 35a13 13 0 0 0 21 10c0 6-2 9-5 12h20c-3-3-5-6-5-12a13 13 0 0 0 21-10c0-16-26-35-26-35Z"
              fill="var(--navy)"
            ></path>
            {/* small corner pips */}
            <path class="pip pip--tl"
              d="M19 36c0 0-7 5-7 9a3.5 3.5 0 0 0 5.6 2.7c0 1.6-.5 2.4-1.3 3.3h5.4c-.8-.9-1.3-1.7-1.3-3.3A3.5 3.5 0 0 0 26 45c0-4-7-9-7-9Z"
              fill="var(--brand)"></path>
          </svg>
        </div>

        {/* Poker chip — large, blue */}
        <div class="chip chip--blue float-a">
          <svg viewBox="0 0 96 96" width="96" height="96" focusable="false">
            <circle cx="48" cy="48" r="46" fill="var(--brand)"></circle>
            <circle cx="48" cy="48" r="46" fill="none" stroke="var(--brand-dark)" stroke-width="3"></circle>
            {/* edge notches */}
            <g fill="#ffffff">
              <rect x="44" y="2" width="8" height="12" rx="2"></rect>
              <rect x="44" y="82" width="8" height="12" rx="2"></rect>
              <rect x="2" y="44" width="12" height="8" rx="2"></rect>
              <rect x="82" y="44" width="12" height="8" rx="2"></rect>
              <rect x="44" y="2" width="8" height="12" rx="2" transform="rotate(45 48 48)"></rect>
              <rect x="44" y="2" width="8" height="12" rx="2" transform="rotate(135 48 48)"></rect>
              <rect x="44" y="2" width="8" height="12" rx="2" transform="rotate(225 48 48)"></rect>
              <rect x="44" y="2" width="8" height="12" rx="2" transform="rotate(315 48 48)"></rect>
            </g>
            <circle cx="48" cy="48" r="28" fill="none" stroke="#ffffff" stroke-width="3"
              stroke-dasharray="4 6"></circle>
            <circle cx="48" cy="48" r="18" fill="#ffffff" opacity="0.9"></circle>
            <path d="M48 38l3 6 6 .6-4.4 4.2 1.1 6L48 51.9 42.3 54.8l1.1-6L39 44.6l6-.6Z"
              fill="var(--brand)"></path>
          </svg>
        </div>

        {/* Poker chip — small, white/light */}
        <div class="chip chip--white float-b">
          <svg viewBox="0 0 72 72" width="72" height="72" focusable="false">
            <circle cx="36" cy="36" r="34" fill="#ffffff"></circle>
            <circle cx="36" cy="36" r="34" fill="none" stroke="var(--brand)" stroke-width="3"></circle>
            <g fill="var(--brand)">
              <rect x="32" y="2" width="8" height="10" rx="2"></rect>
              <rect x="32" y="60" width="8" height="10" rx="2"></rect>
              <rect x="2" y="32" width="10" height="8" rx="2"></rect>
              <rect x="60" y="32" width="10" height="8" rx="2"></rect>
            </g>
            <circle cx="36" cy="36" r="20" fill="none" stroke="var(--brand)" stroke-width="2"
              stroke-dasharray="3 5"></circle>
          </svg>
        </div>

        {/* Die — small, top-right */}
        <div class="die float-c">
          <svg viewBox="0 0 64 64" width="64" height="64" focusable="false">
            <rect x="3" y="3" width="58" height="58" rx="14" fill="#ffffff"
              stroke="var(--line-2)" stroke-width="2"></rect>
            <g fill="var(--navy)">
              <circle cx="20" cy="20" r="4.5"></circle>
              <circle cx="44" cy="20" r="4.5"></circle>
              <circle cx="20" cy="44" r="4.5"></circle>
              <circle cx="44" cy="44" r="4.5"></circle>
              <circle cx="32" cy="32" r="4.5"></circle>
            </g>
          </svg>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---------- Band: light-blue gradient ---------- */
  .hero {
    position: relative;
    overflow: hidden;
    background: linear-gradient(180deg, var(--bg-band) 0%, var(--bg-band-2) 100%);
    border-bottom: 1px solid var(--line);
    padding-block: clamp(2.5rem, 1.4rem + 4.5vw, 5rem);
  }

  .hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(1.5rem, 1rem + 3vw, 3.5rem);
  }

  /* ---------- LEFT copy ---------- */
  .hero__title {
    font-size: clamp(2.1rem, 1.4rem + 3.2vw, 3.4rem);
    line-height: 1.08;
    color: var(--navy);
    margin-bottom: 0.5em;
  }
  .hero__accent {
    color: var(--brand);
  }
  .hero__subtext {
    max-width: 46ch;
    color: var(--ink-2);
    margin-bottom: 1.6rem;
  }

  /* Trust pills */
  .hero__pills {
    display: flex;
    flex-wrap: wrap;
    gap: 1.1rem 1.5rem;
    margin-bottom: 2rem;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
  }
  .pill__chip {
    flex: none;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--brand-soft);
    color: var(--brand);
  }
  .pill__text {
    display: inline-flex;
    flex-direction: column;
    line-height: 1.15;
  }
  .pill__label {
    font-weight: 800;
    font-size: 0.95rem;
    color: var(--navy);
    letter-spacing: -0.01em;
  }
  .pill__sub {
    font-size: 0.78rem;
    color: var(--ink-3);
  }

  .hero__cta {
    display: flex;
  }

  /* ---------- RIGHT visual stage ---------- */
  .hero__visual {
    position: relative;
    min-height: 0;
  }
  .stage {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    max-width: 460px;
    margin-inline: auto;
  }

  /* Soft blurred brand blobs */
  .blob {
    position: absolute;
    border-radius: 50%;
    background: var(--brand-soft);
    filter: blur(34px);
    opacity: 0.85;
  }
  .blob--a {
    width: 62%;
    height: 62%;
    top: 4%;
    left: 8%;
    background: radial-gradient(circle at 30% 30%, #cfe1fb, var(--brand-soft));
  }
  .blob--b {
    width: 48%;
    height: 48%;
    bottom: 4%;
    right: 6%;
    background: radial-gradient(circle at 60% 40%, #e2ecfd, var(--brand-soft));
  }

  /* Faint "+" cross watermark */
  .cross {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 88%;
    height: 88%;
    transform: translate(-50%, -50%);
  }

  /* Floating pieces — absolutely positioned over the stage */
  .card-piece,
  .chip,
  .die {
    position: absolute;
    filter: drop-shadow(0 14px 26px rgba(11, 31, 58, 0.18));
  }
  .card-piece {
    top: 14%;
    left: 50%;
    transform: translateX(-50%) rotate(-7deg);
    z-index: 3;
  }
  .card-piece .playing-card {
    width: clamp(96px, 26vw, 132px);
    height: auto;
  }
  .chip svg,
  .die svg {
    width: 100%;
    height: auto;
  }
  .chip--blue {
    width: clamp(76px, 21vw, 104px);
    bottom: 12%;
    left: 4%;
    z-index: 4;
  }
  .chip--white {
    width: clamp(58px, 16vw, 80px);
    bottom: 6%;
    right: 16%;
    z-index: 2;
  }
  .die {
    width: clamp(48px, 13vw, 66px);
    top: 8%;
    right: 6%;
    z-index: 4;
  }

  /* ---------- Float animation (gated by prefers-reduced-motion) ---------- */
  @keyframes floatA {
    0%, 100% { transform: translateY(0) rotate(-4deg); }
    50% { transform: translateY(-14px) rotate(-1deg); }
  }
  @keyframes floatB {
    0%, 100% { transform: translateY(0) rotate(6deg); }
    50% { transform: translateY(-10px) rotate(3deg); }
  }
  @keyframes floatC {
    0%, 100% { transform: translateY(0) rotate(8deg); }
    50% { transform: translateY(-12px) rotate(12deg); }
  }
  @keyframes floatCard {
    0%, 100% { transform: translateX(-50%) rotate(-7deg) translateY(0); }
    50% { transform: translateX(-50%) rotate(-5deg) translateY(-10px); }
  }
  .float-a { animation: floatA 6s ease-in-out infinite; }
  .float-b { animation: floatB 7.5s ease-in-out infinite; }
  .float-c { animation: floatC 5.5s ease-in-out infinite; }
  .float-card { animation: floatCard 8s ease-in-out infinite; }

  /* ---------- Responsive ---------- */
  /* Tablet & below: stack columns, hero text first. */
  @media (max-width: 900px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .hero__visual {
      order: -1;
    }
    .stage {
      max-width: 380px;
    }
  }

  /* Phones: hide the decorative visual entirely (prevents overflow, keeps it lean). */
  @media (max-width: 560px) {
    .hero__visual {
      display: none;
    }
    .hero__pills {
      gap: 0.9rem 1.1rem;
    }
    .hero__cta .btn-cta {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .float-a,
    .float-b,
    .float-c,
    .float-card {
      animation: none !important;
    }
  }
</style>
