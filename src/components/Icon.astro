---
/**
 * Icon.astro — inline line-icon system.
 * All icons share a 24x24 viewBox, stroke=currentColor, 1.75 stroke-width,
 * round caps/joins, no fill. Colour them by setting `color` on a parent.
 *
 * Usage:
 *   <Icon name="shield" />
 *   <Icon name="star" size={18} class="text-star" />
 */
interface Props {
  name: IconName;
  size?: number | string;
  class?: string;
  title?: string;
}

const { name, size = 24, class: className, title } = Astro.props;

// Inner path markup for each icon (everything inside the shared <svg>).
const ICONS = {
  bolt: '<path d="M13 2 4.5 13.5H11l-1 8.5 8.5-11.5H12l1-8.5Z"/>',
  shield:
    '<path d="M12 3 5 6v5c0 4.2 2.8 7.9 7 9 4.2-1.1 7-4.8 7-9V6l-7-3Z"/>',
  gift:
    '<rect x="3.5" y="9" width="17" height="5"/><path d="M5 14v7h14v-7"/><path d="M12 9v12"/><path d="M12 9C12 9 11 4 8.5 4S6 8 12 9Z"/><path d="M12 9c0 0 1-5 3.5-5S18 8 12 9Z"/>',
  clock:
    '<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3.5 2"/>',
  wallet:
    '<path d="M3.5 7.5A2.5 2.5 0 0 1 6 5h11v3"/><path d="M3.5 7.5V18a2 2 0 0 0 2 2H19a1.5 1.5 0 0 0 1.5-1.5V10A1.5 1.5 0 0 0 19 8.5H5.5a2 2 0 0 1-2-1Z"/><circle cx="16.5" cy="14" r="1.2"/>',
  percent:
    '<path d="m19 5-14 14"/><circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/>',
  headset:
    '<path d="M4 13v-1a8 8 0 0 1 16 0v1"/><path d="M4 13a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2 1 1 0 0 1-1-1v-4a1 1 0 0 1 1-1Z"/><path d="M20 13a2 2 0 0 0-2 2v2a2 2 0 0 0 2 2 1 1 0 0 0 1-1v-4a1 1 0 0 0-1-1Z"/><path d="M18 19v.5a2.5 2.5 0 0 1-2.5 2.5H13"/>',
  card:
    '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3 9.5h18"/><path d="M6.5 14.5h4"/>',
  dice:
    '<rect x="4" y="4" width="16" height="16" rx="3"/><circle cx="9" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="9" r="1" fill="currentColor" stroke="none"/><circle cx="9" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="15" cy="15" r="1" fill="currentColor" stroke="none"/><circle cx="12" cy="12" r="1" fill="currentColor" stroke="none"/>',
  mobile:
    '<rect x="6.5" y="2.5" width="11" height="19" rx="2.5"/><path d="M10.5 18.5h3"/>',
  star:
    '<path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.9 6.7 19.6l1.1-6L3.4 9.4l6-.8L12 3Z"/>',
  "star-half":
    '<path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.9 6.7 19.6l1.1-6L3.4 9.4l6-.8L12 3Z"/><path d="m12 3 2.6 5.6 6 .8-4.4 4.2 1.1 6L12 16.9Z" fill="currentColor" stroke="none"/>',
  check: '<path d="m4.5 12.5 5 5 10-11"/>',
  x: '<path d="M6 6l12 12M18 6 6 18"/>',
  "chevron-right": '<path d="m9 5 7 7-7 7"/>',
  "chevron-down": '<path d="m5 9 7 7 7-7"/>',
  search:
    '<circle cx="11" cy="11" r="7"/><path d="m20 20-3.6-3.6"/>',
  menu: '<path d="M4 7h16M4 12h16M4 17h16"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  "arrow-right": '<path d="M4 12h15"/><path d="m13 6 6 6-6 6"/>',
  plus: '<path d="M12 5v14M5 12h14"/>',
  spade:
    '<path d="M12 3C12 3 4 9 4 14a4 4 0 0 0 6.5 3.1c0 1.8-.6 2.9-1.5 3.9h6c-.9-1-1.5-2.1-1.5-3.9A4 4 0 0 0 20 14c0-5-8-11-8-11Z"/>',
  trophy:
    '<path d="M7 4h10v5a5 5 0 0 1-10 0V4Z"/><path d="M7 6H4v1a3 3 0 0 0 3 3"/><path d="M17 6h3v1a3 3 0 0 1-3 3"/><path d="M12 14v3"/><path d="M8.5 20.5h7"/><path d="M9.5 17.5h5l.5 3h-6Z"/>',
  info:
    '<circle cx="12" cy="12" r="9"/><path d="M12 11v5"/><circle cx="12" cy="7.8" r="0.6" fill="currentColor" stroke="none"/>',
  lock:
    '<rect x="5" y="10.5" width="14" height="10" rx="2.5"/><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5"/><path d="M12 14.5v2.5"/>',
} as const;

export type IconName = keyof typeof ICONS;

const inner = ICONS[name];
if (!inner) {
  throw new Error(
    `Icon: unknown name "${name}". Valid names: ${Object.keys(ICONS).join(", ")}`
  );
}

const dim = typeof size === "number" ? `${size}` : size;
const a11y = title
  ? ({ role: "img", "aria-label": title } as const)
  : ({ "aria-hidden": "true", focusable: "false" } as const);
---

<svg
  class:list={["icon", className]}
  width={dim}
  height={dim}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="round"
  stroke-linejoin="round"
  {...a11y}
  set:html={title ? `<title>${title}</title>${inner}` : inner}
/>

<style>
  .icon {
    display: inline-block;
    flex: none;
    vertical-align: middle;
  }
</style>
