---
/**
 * CroHook.astro — env-gated, consent-aware CRO/analytics hook (PostHog).
 *
 * PURPOSE: give the team a future A/B-testing + conversion hook WITHOUT shipping
 * any tracking by default. The component is INERT unless a build-time env var
 * `PUBLIC_POSTHOG_KEY` is provided:
 *
 *   - No `PUBLIC_POSTHOG_KEY`  → renders NOTHING. Zero bytes, zero requests,
 *                                zero cookies. The default build is unchanged,
 *                                so there is NO consent/privacy regression and
 *                                the 0-main-thread-JS profile is preserved.
 *   - `PUBLIC_POSTHOG_KEY` set  → loads PostHog in a deliberately COOKIELESS,
 *                                consent-light configuration:
 *                                  • persistence: 'memory'      (no cookies / no
 *                                    localStorage identifiers written)
 *                                  • autocapture: false         (no implicit DOM
 *                                    event capture)
 *                                  • capture_pageview: false    (no auto pageview;
 *                                    the team opts in explicitly later)
 *                                  • disable_session_recording  (no replay)
 *                                  • respect DNT                (honours Do-Not-Track)
 *                                This means even when enabled it does not create
 *                                persistent cross-page identifiers — so it does
 *                                not regress the current (banner-less) consent
 *                                posture. A full CMP/Consent Mode decision is a
 *                                separate legal follow-up (already noted in
 *                                BaseLayout for the Google tags).
 *
 * The `data-experiment` attributes on the toplist CTAs (CasinoRow) are the
 * companion hook: they are inert HTML attributes a future experiment can target.
 *
 * Env:
 *   PUBLIC_POSTHOG_KEY   PostHog project API key (public). REQUIRED to activate.
 *   PUBLIC_POSTHOG_HOST  PostHog host (optional; defaults to EU cloud).
 */
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const POSTHOG_HOST =
  import.meta.env.PUBLIC_POSTHOG_HOST || "https://eu.i.posthog.com";

// Hard gate: without a key this component is completely inert (renders nothing).
const enabled =
  typeof POSTHOG_KEY === "string" && POSTHOG_KEY.trim().length > 0;

// JSON-encode the values we inline so they cannot break out of the script.
const keyJson = JSON.stringify(POSTHOG_KEY ?? "");
const hostJson = JSON.stringify(POSTHOG_HOST);
---

{enabled && (
  <script type="text/partytown" is:inline set:html={`
    (function () {
      try {
        var dnt = navigator.doNotTrack || window.doNotTrack;
        if (dnt === '1' || dnt === 'yes') return; // honour Do-Not-Track
      } catch (e) {}
      !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.async=!0,p.src=s.api_host+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures getActiveMatchingSurveys getSurveys onSessionId".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
      posthog.init(${keyJson}, {
        api_host: ${hostJson},
        persistence: 'memory',
        autocapture: false,
        capture_pageview: false,
        capture_pageleave: false,
        disable_session_recording: true,
        disable_surveys: true,
        respect_dnt: true
      });
    })();
  `} />
)}
