# Matching Visions Content Engine feed (articles published under /uutiset/).
#
# Where the values come from: the engine dashboard -> Keys. Create a
# SITE-SCOPED API key for "Kasinot ilman rekisteröitymistä" with the
# `articles:read` scope. CE_API_URL is the engine deployment's API base
# (including /v1). Set both locally in .env and in Vercel -> Settings ->
# Environment Variables.
#
# Both are optional: without them the build still succeeds, /uutiset/ is
# just empty of engine articles.
CE_API_URL=https://<engine-deployment>/v1
CE_API_KEY=<site-scoped key with articles:read>

# ---------------------------------------------------------------------------
# CRO / A-B TESTING HOOK (PostHog) — OPTIONAL, OFF BY DEFAULT.
#
# Leave these UNSET to ship NO tracking: the CroHook component renders nothing,
# no PostHog script loads, no cookies are written, and the consent posture is
# unchanged. Set PUBLIC_POSTHOG_KEY only when you have made a CMP/consent
# decision. When set, PostHog runs cookieless (persistence:'memory', autocapture
# off, Do-Not-Track respected) in a Partytown web worker.
#
# PUBLIC_POSTHOG_HOST is optional and defaults to https://eu.i.posthog.com.
# PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
